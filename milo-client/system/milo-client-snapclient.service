[Unit]
Description=Snapclient for Milo Client
After=network-online.target milo-client.service
Wants=network-online.target
Requires=milo-client.service

[Service]
Type=simple
User=milo-client
Group=audio
EnvironmentFile=/var/lib/milo-client/env

ExecStart=/bin/sh -c '/usr/bin/snapclient -h ${MILO_PRINCIPAL_IP} -p 1704 --hostID $(cat /sys/class/net/eth0/address 2>/dev/null || cat /sys/class/net/wlan0/address 2>/dev/null || echo "milo-client") --logsink=system --soundcard camilladsp_input --mixer software --player alsa:buffer_time=${MILO_SNAPCLIENT_BUFFER_TIME},fragments=${MILO_SNAPCLIENT_FRAGMENTS}'

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
