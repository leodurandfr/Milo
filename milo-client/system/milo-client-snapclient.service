[Unit]
Description=Snapclient for Milo Client
After=network-online.target milo-client.service
Wants=network-online.target
Requires=milo-client.service
BindsTo=milo-client.service

[Service]
Type=simple
User=milo-client
Group=audio
EnvironmentFile=/var/lib/milo-client/env

ExecStart=/usr/local/bin/milo-client-snapclient-launcher

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
