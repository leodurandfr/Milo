[Unit]
Description=Milo Client API Service
After=network.target

[Service]
Type=notify
TimeoutStartSec=30
User=milo-client
Group=audio
WorkingDirectory=/home/milo-client/repo/milo-client/app
ExecStart=/home/milo-client/venv/bin/python3 main.py

Restart=always
RestartSec=5
TimeoutStopSec=10

EnvironmentFile=/var/lib/milo-client/env
# /run/milo-client: the address server_address_watch chose for snapclient's next
# start, read once by its launcher. Emptied with the app, so no choice outlives
# the process that made it, nor a reboot.
RuntimeDirectory=milo-client

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
