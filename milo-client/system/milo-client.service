[Unit]
Description=Milo Client API Service
After=network.target

[Service]
Type=notify
TimeoutStartSec=30
User=milo-client
Group=audio
# "-": a power cut inside an app update's swap can leave no app/ at all, and a
# missing WorkingDirectory fails the start (200/CHDIR) before ExecStartPre runs
# — the guard below could never put the previous app/ back. Measured with
# systemd 257: with "-" the guard runs from / and ExecStart, which chdirs anew,
# runs in the app/ it restored.
WorkingDirectory=-/home/milo-client/repo/milo-client/app
# The trial of a pushed app version (app/services/app_update.py): counts this
# start and, at the last one the trial allows, puts the previous version back
# before it runs. "-" so the guard can never keep the app down. Its time counts
# against TimeoutStartSec, and the server's wait for a verdict is bounded on
# both values below.
ExecStartPre=-/usr/local/bin/milo-client-update-guard start
ExecStart=/home/milo-client/venv/bin/python3 main.py

Restart=always
RestartSec=5
TimeoutStopSec=10
# A process that answers nothing but never exits (a wedged event loop) is
# restarted: main.py feeds WATCHDOG=1 from that loop from READY=1 on. Without
# it, a pushed version that hangs after READY neither commits its trial nor
# reaches the start that rolls it back, and the room's API stays dead. Killed
# by SIGABRT, which faulthandler turns into the loop's stack in the journal.
WatchdogSec=30

EnvironmentFile=/var/lib/milo-client/env
# /run/milo-client: the address server_address_watch chose for snapclient's next
# start, read once by its launcher. Emptied with the app, so no choice outlives
# the process that made it, nor a reboot.
RuntimeDirectory=milo-client

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
