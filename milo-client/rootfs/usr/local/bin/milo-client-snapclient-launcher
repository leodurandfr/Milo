#!/bin/sh
# Milo Client - Snapclient launcher
#
# Resolves MILO_PRINCIPAL_IP to a literal IP at service start, then runs
# snapclient with the resolved address. This avoids snapclient's internal
# reconnect loop re-issuing mDNS lookups for milo.local — which can stall
# for ~30s on transient avahi failures and turn a brief network glitch into
# an audible audio drop.
#
# Nothing here re-resolves afterwards, and Restart=on-failure cannot help:
# snapclient retries a dead address in-process forever rather than exiting, so
# the unit never fails. Following the server when it moves between Ethernet and
# WiFi is the job of the API's follow_server_address(), which stop/starts this
# unit when the literal below has gone stale and snapclient has no connection,
# when mDNS has answered another address for its hold while snapclient is
# connected — playing or not — and when the stream does not leave from the
# satellite's own eth0 once that has come back. Ethernet first, at the cost of
# a few seconds of silence in that room (the owner's choice, 2026-11-06). When the
# watcher restarts it for the server's address, it leaves the address it found
# in the override below.
#
# The server is looked for in the order the API's resolver follows
# (services/registration.py::resolve_milo_principal): MILO_PRINCIPAL_IP when it
# is a literal, that name (milo.local) resolved, then the first of the addresses
# the server's last heartbeat answer listed that accepts a connect — the way
# back on a LAN whose router filters multicast, where milo.local never resolves.
#
# Before resolving, it waits for NetworkManager's startup: the image masks
# NetworkManager-wait-online, so the unit's After=network-online.target waits for
# nothing, and a wired satellite that also holds the server's WiFi leases wlan0
# first — snapclient then connected from the WiFi address and kept that
# connection for hours (measured on Bureau).
#
# Environment variables (provided by /var/lib/milo-client/env):
#   MILO_PRINCIPAL_IP            hostname or IPv4 address of the main Milō server
#   MILO_SNAPCLIENT_BUFFER_TIME  ALSA buffer time in ms (default 80)
#   MILO_SNAPCLIENT_FRAGMENTS    ALSA fragments (default 4)

set -eu

HARDWARE_FILE="/var/lib/milo-client/hardware.json"

# Skip launch entirely when no audio card is configured (matches previous behavior)
audio_id=$(python3 -c \
    "import json,sys;d=json.load(sys.stdin);print(d.get(sys.argv[1],{}).get(sys.argv[2],sys.argv[3]))" \
    audio id none < "$HARDWARE_FILE" 2>/dev/null || echo "none")

if [ "$audio_id" = "none" ]; then
    echo "milo-client-snapclient-launcher: no audio card configured, skipping snapclient"
    exit 0
fi

# Run what the masked NetworkManager-wait-online ran (nm-online -s, 60 s): wait
# for NetworkManager's startup, which completes once eth0 has its IPv4
# (90-milo-ethernet-ipv4.conf) or gave up. One read of eth0's state cannot do it:
# a cable still negotiating reads "no carrier" (20) for seconds, exactly like a
# missing one. A missing cable holds startup only for NetworkManager's own
# carrier wait (carrier-wait-timeout, 6 s), and only at boot, while wlan0 comes
# up; after boot nm-online -s answers at once (an app restart, a push). 60 s
# outlasts that carrier wait plus eth0's DHCP timeout (45 s), and the timeout is
# monotonic, so the clock step at boot cannot cut it short. Fails open.
uptime_s() { read -r up _ < /proc/uptime; echo "${up%.*}"; }
started=$(uptime_s)
if nm-online -s -q -t 60; then
    echo "milo-client-snapclient-launcher: NetworkManager startup complete after $(($(uptime_s) - started)) s"
else
    rc=$?
    echo "milo-client-snapclient-launcher: nm-online -s exited $rc after $(($(uptime_s) - started)) s, starting anyway" >&2
fi

# Resolve MILO_PRINCIPAL_IP if it looks like a hostname.
# Numeric literals (1.2.3.4) are passed through unchanged — covers a LAN where
# mDNS does not work and the env file carries a literal address.
server="${MILO_PRINCIPAL_IP:-milo.local}"

# The addresses the server's last heartbeat answer listed, wired first, one per
# line; the app keeps them on the card.
known_addresses=/var/lib/milo-client/server-addresses
# The backend's port, which the app's probe dials too.
server_port=8000

# The first known address at which the server accepts a connect, or nothing.
# Probed all at once, as the app does, and taken in their listed order.
answering_address() {
    [ -s "$known_addresses" ] || return 0
    python3 - "$known_addresses" "$server_port" <<'EOF' 2>/dev/null || true
import ipaddress, socket, sys, threading

addresses = []
for line in open(sys.argv[1], encoding="ascii").read().split():
    try:
        addresses.append(str(ipaddress.IPv4Address(line)))
    except ValueError:
        pass
answered = set()

def probe(address):
    try:
        socket.create_connection((address, int(sys.argv[2])), timeout=1).close()
        answered.add(address)
    except OSError:
        pass

threads = [threading.Thread(target=probe, args=(a,)) for a in addresses]
for t in threads:
    t.start()
for t in threads:
    t.join()
print(next((a for a in addresses if a in answered), ""))
EOF
}

# Unless the API's watcher chose this start's address — the one it found the
# server at: what the resolver answers, or, where the main Milo stopped
# answering at the address mDNS still gives (a server whose cable went keeps
# its wired address published for seconds), another it listed in its
# heartbeat. Read once and removed, so only the start it was written for uses it.
override=/run/milo-client/server-address
if [ -s "$override" ]; then
    server=$(cat "$override")
    rm -f "$override"
    echo "milo-client-snapclient-launcher: dialling $server, the address the watcher chose"
fi
case "$server" in
    *[!0-9.]*)
        # Hostname — try to resolve, retry up to ~10s for slow avahi/DNS at boot.
        # IPv4 only, as the API's resolver: the watcher compares this address with
        # the one it resolves, and snapclient's server URI cannot carry an IPv6
        # literal (0.35: `tcp://[::1]` resolves "[", `tcp://::1` falls back to
        # mDNS discovery — measured).
        resolved=""
        i=0
        while [ "$i" -lt 5 ]; do
            resolved=$(getent ahostsv4 "$server" 2>/dev/null | awk 'NR == 1 {print $1}')
            [ -n "$resolved" ] && break
            i=$((i + 1))
            sleep 2
        done
        if [ -n "$resolved" ]; then
            echo "milo-client-snapclient-launcher: resolved $server -> $resolved"
            server="$resolved"
        else
            known=$(answering_address)
            if [ -n "$known" ]; then
                echo "milo-client-snapclient-launcher: could not resolve $server, dialing $known, the first address the server last listed that answers"
                server="$known"
            else
                echo "milo-client-snapclient-launcher: could not resolve $server and no address the server last listed answers, falling back to hostname (snapclient will retry internally)" >&2
            fi
        fi
        ;;
esac

# The hostID is this unit's identity, the one its registration announces too.
host_id=$(/usr/local/bin/milo-host-id) || host_id="milo-client"

# The server goes last, as a URI: snapclient 0.35 deprecates -h/-p.
exec /usr/bin/snapclient \
    --hostID "$host_id" \
    --logsink=system \
    --soundcard camilladsp_input \
    --mixer none \
    --player "alsa:buffer_time=${MILO_SNAPCLIENT_BUFFER_TIME:-80},fragments=${MILO_SNAPCLIENT_FRAGMENTS:-4}" \
    "tcp://$server:1704"
