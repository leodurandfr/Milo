#!/bin/sh
# Milo Client - Snapclient launcher
#
# Resolves MILO_PRINCIPAL_IP to a literal IP at service start, then runs
# snapclient with the resolved address. This avoids snapclient's internal
# reconnect loop re-issuing mDNS lookups for milo.local — which can stall
# for ~30s on transient avahi failures and turn a brief network glitch into
# an audible audio drop.
#
# Nothing here re-resolves afterwards, and Restart=on-failure cannot help:
# snapclient retries a dead address in-process forever rather than exiting, so
# the unit never fails. Following the server when it moves between Ethernet and
# WiFi is the job of the API's follow_server_address(), which stop/starts this
# unit once the literal below has gone stale *and* snapclient holds no
# connection — a client that is streaming is never interrupted for an address.
#
# Before resolving, it waits for an eth0 that is still coming up: the image masks
# NetworkManager-wait-online, so the unit's After=network-online.target waits for
# nothing, and a wired satellite that also holds the server's WiFi leases wlan0
# first — snapclient then connected from the WiFi address and kept that
# connection for hours (measured on Bureau).
#
# Environment variables (provided by /var/lib/milo-client/env):
#   MILO_PRINCIPAL_IP            hostname or IP of the main Milō server
#   MILO_SNAPCLIENT_BUFFER_TIME  ALSA buffer time in ms (default 80)
#   MILO_SNAPCLIENT_FRAGMENTS    ALSA fragments (default 4)

set -eu

HARDWARE_FILE="/var/lib/milo-client/hardware.json"

# Skip launch entirely when no audio card is configured (matches previous behavior)
audio_id=$(python3 -c \
    "import json,sys;d=json.load(sys.stdin);print(d.get(sys.argv[1],{}).get(sys.argv[2],sys.argv[3]))" \
    audio id none < "$HARDWARE_FILE" 2>/dev/null || echo "none")

if [ "$audio_id" = "none" ]; then
    echo "milo-client-snapclient-launcher: no audio card configured, skipping snapclient"
    exit 0
fi

# NetworkManager's state of eth0 as a number; 0 when it cannot say (no eth0, NM
# not answering yet). 40-99 is an activation in progress, and 100 means IPv4 is
# up (90-milo-ethernet-ipv4.conf). An eth0 with no carrier (20) or no activation
# started yet (30) does not wait, so a satellite on WiFi alone starts at once.
# The cap runs on /proc/uptime, since the wall clock is stepped at boot.
eth0_state() {
    s=$(timeout 3 nmcli -t -g GENERAL.STATE device show eth0 2>/dev/null | cut -d' ' -f1)
    case "$s" in ''|*[!0-9]*) s=0 ;; esac
    echo "$s"
}
uptime_s() { read -r up _ < /proc/uptime; echo "${up%.*}"; }
activating() { [ "$state" -ge 40 ] && [ "$state" -lt 100 ]; }

state=$(eth0_state)
if activating; then
    started=$(uptime_s)
    now=$started
    echo "milo-client-snapclient-launcher: eth0 is activating (state $state), waiting up to 45 s"
    while activating && [ "$now" -lt $((started + 45)) ]; do
        sleep 1
        state=$(eth0_state)
        now=$(uptime_s)
    done
    if activating; then
        echo "milo-client-snapclient-launcher: eth0 still activating (state $state) after 45 s, starting anyway" >&2
    else
        echo "milo-client-snapclient-launcher: eth0 reached state $state after $((now - started)) s"
    fi
fi

# Resolve MILO_PRINCIPAL_IP if it looks like a hostname.
# Numeric literals (1.2.3.4) are passed through unchanged — covers a LAN where
# mDNS does not work and the env file carries a literal address.
server="${MILO_PRINCIPAL_IP:-milo.local}"
case "$server" in
    *[!0-9.]*)
        # Hostname — try to resolve, retry up to ~10s for slow avahi/DNS at boot
        resolved=""
        i=0
        while [ "$i" -lt 5 ]; do
            resolved=$(getent hosts "$server" 2>/dev/null | awk '{print $1}' | head -n1)
            [ -n "$resolved" ] && break
            i=$((i + 1))
            sleep 2
        done
        if [ -n "$resolved" ]; then
            echo "milo-client-snapclient-launcher: resolved $server -> $resolved"
            server="$resolved"
        else
            echo "milo-client-snapclient-launcher: could not resolve $server, falling back to hostname (snapclient will retry internally)" >&2
        fi
        ;;
esac

# Build hostID from primary interface MAC (eth0 preferred, wlan0 fallback)
eth_mac=$(cat /sys/class/net/eth0/address 2>/dev/null || true)
if [ -n "$eth_mac" ] && [ "$eth_mac" != "00:00:00:00:00:00" ]; then
    host_id="$eth_mac"
else
    host_id=$(cat /sys/class/net/wlan0/address 2>/dev/null || echo "milo-client")
fi

exec /usr/bin/snapclient \
    -h "$server" \
    -p 1704 \
    --hostID "$host_id" \
    --logsink=system \
    --soundcard camilladsp_input \
    --mixer none \
    --player "alsa:buffer_time=${MILO_SNAPCLIENT_BUFFER_TIME:-80},fragments=${MILO_SNAPCLIENT_FRAGMENTS:-4}"
