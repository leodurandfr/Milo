#!/bin/bash
# milo-client-apply-hardware — Apply audio hardware configuration and reboot
#
# Reads /var/lib/milo-client/hardware.json and updates /boot/firmware/config.txt
# with the correct dtoverlay for the audio card.
# Must be run as root (via sudoers rule).
#
# Managed block in config.txt:
#   # BEGIN MILO CLIENT AUDIO ... # END MILO CLIENT AUDIO
#
# Usage:
#   milo-client-apply-hardware              # Apply config and reboot
#   milo-client-apply-hardware --no-reboot  # Apply config without rebooting

set -euo pipefail

source /usr/local/lib/milo/hardware-helpers.sh

HARDWARE_FILE="/var/lib/milo-client/hardware.json"
NO_REBOOT=false

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        --no-reboot) NO_REBOOT=true ;;
        *) echo "ERROR: Unknown argument '$arg'" >&2; exit 1 ;;
    esac
done

resolve_config_file

# =============================================================================
# Validation
# =============================================================================

validate_hardware_json

AUDIO_OVERLAY=$(read_json "audio.overlay")
validate_audio_overlay "$AUDIO_OVERLAY"

# =============================================================================
# Backup config.txt
# =============================================================================

backup_config

# =============================================================================
# Audio configuration
# =============================================================================

# Always remove previous managed audio block (cleanup)
remove_block "MILO CLIENT AUDIO"

# Always remove legacy (non-managed) entries from old installs
remove_legacy_overlays "# Milo Client - HiFiBerry Audio"

# Only modify built-in audio and write overlay when an audio card is configured
if [[ -n "$AUDIO_OVERLAY" ]]; then
    # Disable built-in audio
    sed -i '/^dtparam=audio=on$/d' "$CONFIG_FILE"

    # Disable GPU audio on vc4 overlays
    disable_vc4_audio

    # Write new audio block
    cat >> "$CONFIG_FILE" << EOF

# BEGIN MILO CLIENT AUDIO
dtoverlay=$AUDIO_OVERLAY
# END MILO CLIENT AUDIO
EOF
fi

# =============================================================================
# Reboot (unless --no-reboot)
# =============================================================================

if [[ "$NO_REBOOT" == "true" ]]; then
    echo "Hardware configuration applied (reboot skipped)."
else
    echo "Hardware configuration applied. Rebooting..."
    /sbin/reboot
fi
