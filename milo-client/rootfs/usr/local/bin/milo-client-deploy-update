#!/bin/bash
# Milo Client - Secure Update Deployment Wrapper
# Copies system files and rootfs files from an extracted update tarball
set -euo pipefail

error_exit() { echo "ERROR: $1" >&2; exit 1; }

# An update that changed nothing on disk and one that replaced every unit file
# read identically in the journal, and the journal is the only surface this
# machine has. Everything installed below is compared before it is overwritten,
# and what actually moved is listed at the end.
CHANGED=()
would_change() {
    # $1 source, $2 destination — true when copying would alter the destination.
    [ -f "$2" ] || return 0
    ! cmp -s "$1" "$2"
}

# Install this very script, which a plain `cp` cannot do: bash reads a script
# lazily by byte offset, so overwriting it mid-run makes the shell resume at the
# same offset in different bytes and die on a syntax error in whatever token it
# lands in — after the deploy has already happened, so the caller sees a failure
# for work that was done. It cost the fleet every satellite app update it ever
# attempted.
#
# Writing beside it and renaming is the fix, not skipping it: rename(2) swaps
# the directory entry while this process keeps reading the inode it opened, so
# the running shell is untouched and the next run is the new script. Skipping
# was what left a paired satellite on a deploy script no push could ever
# update — every later fix to this file stopped at the unit's door, silently.
# Same shape as the server's milo-deploy-update.
#
# The `.new` file must sit in the destination directory, not /tmp: mv across
# filesystems degrades to copy-then-unlink, which is exactly the in-place
# overwrite this avoids.
install_self() {
    local rel_path="$1"
    would_change "$MILO_DIR/rootfs/$rel_path" "/$rel_path" && CHANGED+=("/$rel_path")
    cp "$MILO_DIR/rootfs/$rel_path" "/$rel_path.new"
    chmod +x "/$rel_path.new"
    mv -f "/$rel_path.new" "/$rel_path"
    echo "  Installed /$rel_path (renamed into place)"
}

# A sudoers policy is validated before it can take effect, and swapped in by
# rename. sudo >= 1.9.3 does not refuse to run over a policy file with a syntax
# error — it skips that file — so a malformed one silently drops all nine grants
# the satellite holds, and the failure surfaces later as a `sat restart` that
# answers "a password is required". The staging name ends in `.new`: sudo
# ignores any file in sudoers.d whose name contains a dot, so the
# half-installed copy is never read as a policy. Same shape as the server's
# milo-deploy-update.
install_sudoers() {
    local rel_path="$1"
    local target="/$rel_path"

    would_change "$MILO_DIR/rootfs/$rel_path" "$target" && CHANGED+=("$target")
    cp "$MILO_DIR/rootfs/$rel_path" "$target.new"
    chmod 0440 "$target.new"
    visudo -c -f "$target.new" >/dev/null || {
        rm -f "$target.new"
        error_exit "sudoers syntax error in $rel_path -- not installed"
    }
    mv -f "$target.new" "$target"
    echo "  Installed $target (validated)"
}

[ $# -ne 1 ] && error_exit "Usage: $0 <extracted-tarball-directory>"

UPDATE_DIR="$1"

# Validate absolute path
[[ "$UPDATE_DIR" != /* ]] && error_exit "Path must be absolute"

# Validate in temp directory only
case "$UPDATE_DIR" in
    /tmp/*) ;;
    *) error_exit "Update directory must be in /tmp" ;;
esac

# Validate expected structure
MILO_DIR="$UPDATE_DIR/milo-client"
[ ! -d "$MILO_DIR/system" ] && error_exit "Missing milo-client/system/ in update"
[ ! -d "$MILO_DIR/rootfs" ] && error_exit "Missing milo-client/rootfs/ in update"

# --- Deploy systemd service files ---
echo "Deploying systemd service files..."
for service_file in "$MILO_DIR"/system/*.service; do
    [ -f "$service_file" ] || continue
    unit=$(basename "$service_file")
    would_change "$service_file" "/etc/systemd/system/$unit" && CHANGED+=("$unit")
    cp "$service_file" /etc/systemd/system/
    echo "  Installed $unit"
done

# Deploy avahi override if present. One spelling, the one pi-gen and
# milo-first-boot use — a second file is a drop-in nothing ever removes, and
# systemd reads them alphabetically, so the stale one would win.
AVAHI_OVERRIDE=/etc/systemd/system/avahi-daemon.service.d/milo-client-override.conf
avahi_changed=0
if [ -f "$MILO_DIR/system/avahi-daemon-override.conf" ]; then
    mkdir -p /etc/systemd/system/avahi-daemon.service.d/
    if would_change "$MILO_DIR/system/avahi-daemon-override.conf" "$AVAHI_OVERRIDE"; then
        avahi_changed=1
        CHANGED+=("avahi-daemon override")
    fi
    cp "$MILO_DIR/system/avahi-daemon-override.conf" "$AVAHI_OVERRIDE"
    rm -f /etc/systemd/system/avahi-daemon.service.d/milo-override.conf
    echo "  Installed avahi-daemon override"
fi

systemctl daemon-reload
echo "  systemctl daemon-reload done"

# avahi-daemon is the only consumer of anything deployed here that nothing else
# brings back. The app update restarts milo-client.service as its last step and
# systemd propagates that to milo-client-camilladsp and milo-client-snapclient —
# measured on a unit: both go inactive with it and return with it, NRestarts
# untouched — so the unit files above and /etc/asound.conf take effect on their
# own. This drop-in would sit reloaded-but-unapplied until the next boot, which
# is how a satellite kept announcing itself on the wrong interface after the fix
# for it had already been deployed. Only on a real change: a restart re-registers
# every mDNS name on the unit, and that is how the server finds it.
if [ "$avahi_changed" -eq 1 ]; then
    systemctl restart avahi-daemon.service
    echo "  Restarted avahi-daemon (its drop-in changed)"
fi

# --- Deploy rootfs files ---
echo "Deploying rootfs files..."
cd "$MILO_DIR/rootfs"

while read -r rel_path; do
    # Remove leading ./
    rel_path="${rel_path#./}"

    # Skip per-device config. This script is the one file a plain copy cannot
    # install — see the rename branch below.
    case "$rel_path" in
        var/lib/milo-client/*) echo "  Skipping /$rel_path (per-device config)"; continue ;;
        etc/avahi/*) echo "  Skipping /$rel_path (per-device config)"; continue ;;
        usr/local/bin/milo-client-deploy-update) install_self "$rel_path"; continue ;;
        etc/sudoers.d/*) install_sudoers "$rel_path"; continue ;;
    esac

    target="/$rel_path"
    target_dir=$(dirname "$target")

    # Create parent directory
    mkdir -p "$target_dir"

    # Copy file
    would_change "$MILO_DIR/rootfs/$rel_path" "$target" && CHANGED+=("$target")
    cp "$MILO_DIR/rootfs/$rel_path" "$target"
    echo "  Installed $target"

    # Set executable for scripts
    case "$target" in
        /usr/local/bin/*|*/dispatcher.d/*)
            chmod +x "$target"
            ;;
    esac

    # Set ownership for home files
    case "$target" in
        /home/milo-client/*)
            chown milo-client:milo-client "$target"
            ;;
    esac
done < <(find . -type f)

if [ ${#CHANGED[@]} -eq 0 ]; then
    echo "Changed nothing: every deployed file already matched"
else
    echo "Changed ${#CHANGED[@]} file(s): ${CHANGED[*]}"
fi

echo "Update deployment complete"
