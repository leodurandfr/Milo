#!/bin/bash
# Milo Client Network Manager - Avahi mDNS interface selection
#
# Keeps both eth0 and wlan0 connected at all times; selects which interface
# Avahi advertises milo-client*.local on. Single-interface advertising avoids
# the self-loop hostname conflict without sacrificing WiFi as a fallback when
# ethernet fails.
#
# Avahi config is reset to eth0 at every boot via systemd ExecStartPre.
# This dispatcher only handles runtime changes (cable plug/unplug, WiFi events).
#
# Selection rules (in priority order):
# - eth0 has an IPv4 address: Avahi on eth0  (ethernet preferred)
# - else:                     Avahi on wlan0 (WiFi fallback)

INTERFACE=$1
ACTION=$2
AVAHI_CONF="/etc/avahi/avahi-daemon.conf"

# Check if interface has an IPv4 address
has_ip() {
    ip -4 addr show "$1" 2>/dev/null | grep -q "inet "
}

# Disable Energy Efficient Ethernet on a wired interface.
# EEE/LPI causes micro-pauses on link wake-up that produce TCP retransmissions
# and Snapcast buffer underruns on the multiroom audio path.
disable_eee() {
    local iface="$1"
    [ -x /usr/sbin/ethtool ] || return 0
    /usr/sbin/ethtool --show-eee "$iface" 2>/dev/null | \
        grep -q "EEE status: enabled" || return 0
    if ! /usr/sbin/ethtool --set-eee "$iface" eee off >/dev/null 2>&1; then
        logger -t milo-network "EEE disable unsupported on $iface (driver limitation)"
    fi
}

# Update Avahi allow/deny-interfaces - only restarts if config actually changes.
# Both keys are written together: Avahi 0.8 ignores allow-interfaces for
# interfaces that appear dynamically, so deny-interfaces is what keeps the
# daemon strictly mono-interface (and prevents self-loop renames).
set_avahi_interface() {
    local interface="$1"
    local deny
    case "$interface" in
        eth0)  deny=wlan0 ;;
        wlan0) deny=eth0  ;;
        *)     return 1   ;;
    esac

    # Skip only if BOTH keys are already correct — checking allow alone would
    # miss drift on deny (the more critical key for runtime enforcement).
    local current_allow current_deny
    current_allow=$(grep "^allow-interfaces=" "$AVAHI_CONF" 2>/dev/null | cut -d= -f2)
    current_deny=$(grep "^deny-interfaces=" "$AVAHI_CONF" 2>/dev/null | cut -d= -f2)
    [ "$current_allow" = "$interface" ] && [ "$current_deny" = "$deny" ] && return 0

    sed -i "s/^allow-interfaces=.*/allow-interfaces=$interface/" "$AVAHI_CONF"
    if grep -q "^deny-interfaces=" "$AVAHI_CONF"; then
        sed -i "s/^deny-interfaces=.*/deny-interfaces=$deny/" "$AVAHI_CONF"
    else
        sed -i "/^allow-interfaces=/a deny-interfaces=$deny" "$AVAHI_CONF"
    fi

    # Restart Avahi to apply changes
    systemctl restart avahi-daemon.service
}

# Decide and apply the correct Avahi interface for the current network state.
apply_avahi_target() {
    if has_ip eth0; then
        set_avahi_interface "eth0"
    elif has_ip wlan0; then
        set_avahi_interface "wlan0"
    fi
    # If neither interface has an IP, leave the state alone — Avahi will pick
    # up the right one on the next up event.
}

case "$INTERFACE" in
    eth0)
        case "$ACTION" in
            up)
                disable_eee eth0
                apply_avahi_target
                ;;
            down)
                apply_avahi_target
                ;;
        esac
        ;;
    wlan0)
        case "$ACTION" in
            up|down)
                apply_avahi_target
                ;;
        esac
        ;;
esac

exit 0
