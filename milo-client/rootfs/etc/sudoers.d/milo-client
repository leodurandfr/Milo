# Milo Client - Permissions for automatic updates and hardware management
#
# Unlike the server's policy these grants are argument-scoped, so a verb or a
# unit name that moves on one side is a silent permission denial on a satellite
# — the one machine CI never touches. Both directions are enforced by
# backend/tests/contracts/test_privileged_exec_contract.py. `systemctl is-active`
# and `is-enabled` are deliberately absent: they need no root, and every call
# site runs them plain.
#
# The first rule is what makes the rest of the file mean anything. A Raspberry
# Pi OS base may ship /etc/sudoers.d/010_pi-nopasswd — a conffile of
# raspberrypi-sys-mods — whose username userconf-pi rewrites on first boot, so
# on a unit that has it and whose appliance account is also the image's first
# user it reads `milo-client ALL=(ALL) NOPASSWD: ALL` and every scoping below is
# decorative. Measured on a satellite: `sudo -n true` succeeded there, and a
# satellite whose account is the first user (Canapé) still lists
# `(ALL) NOPASSWD: ALL` for milo-client (`sudo -l`, 2026-11-07). The current base ships no such file
# (raspberrypi-sys-mods 1:20260612), and on a satellite converted from the image
# the first user is `milo`, not this account (milo-account). sudoers applies the
# *last* matching rule and reads /etc/sudoers.d in lexical order, so this file
# (m…) is read after that one (0…) and takes the passwordless part back. It
# grants nothing new — the account is in the `sudo` group, which already permits
# any command with a password.
#
# Order is load-bearing: this rule must stay above the grants. Below them it
# would also be the last match for a *granted* command, and a satellite would be
# asked for a password it has no way to type.
milo-client ALL=(ALL:ALL) PASSWD: ALL

milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl stop milo-client-snapclient.service
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl start milo-client-snapclient.service
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-install-snapclient
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl stop milo-client-camilladsp.service
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl start milo-client-camilladsp.service
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-install-camilladsp
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-deploy-update
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-apply-hardware
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl restart milo-client.service

# Remote access, driven from the server's client panel (routes/system.py) — the
# same two switches the server's own policy grants its backend. The password
# comes on stdin, so the helper is granted with no argument at all (`""`).
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now ssh.service
milo-client ALL=(root) NOPASSWD: /usr/bin/systemctl disable --now ssh.service
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-set-password ""

# Keeping the server's WiFi as a standby link, pushed by the server at every
# admission (routes/system.py), never from a panel. The app holds no
# NetworkManager right of its own: the polkit rule is the server's, for the
# `milo` user only. The country, SSID and PSK come on stdin: `""` again.
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-join-wifi ""

# Following the server's timezone, pushed by the server like the WiFi
# (routes/system.py). `""` permits the helper with no argument and nothing else:
# the zone comes on stdin, and the helper checks it before timedatectl sees it.
# All three stdin helpers refuse an argument themselves as well, and
# test_privileged_exec_contract.py holds the two sides equal.
milo-client ALL=(root) NOPASSWD: /usr/local/bin/milo-client-set-timezone ""
