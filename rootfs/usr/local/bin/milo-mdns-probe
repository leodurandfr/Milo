#!/usr/bin/env python3
"""
milo-mdns-probe — Check if a hostname exists on the local network via mDNS.

Sends a raw mDNS A-record query to the multicast group 224.0.0.251:5353
(RFC 6762) without requiring avahi-daemon to be running.

Usage: milo-mdns-probe <hostname> [timeout_seconds]
Exit code: 0 if found, 1 if not found, 2 on error.
"""
import socket
import struct
import sys
import time

MDNS_ADDR = "224.0.0.251"
MDNS_PORT = 5353


def encode_qname(hostname):
    """Encode hostname.local as DNS wire-format labels."""
    qname = b""
    for label in (hostname, "local"):
        encoded = label.encode("utf-8")
        qname += struct.pack("!B", len(encoded)) + encoded
    qname += b"\x00"
    return qname


def build_query(hostname):
    """Build a DNS A-record query packet for hostname.local."""
    # Header: ID=0, flags=0, 1 question, 0 answers/auth/additional
    header = struct.pack("!6H", 0, 0, 1, 0, 0, 0)
    # Question: hostname.local IN A (type=1, class=1)
    question = encode_qname(hostname) + struct.pack("!2H", 1, 1)
    return header + question


def response_matches(data, hostname):
    """Check if an mDNS response contains an answer for hostname.local."""
    if len(data) < 12:
        return False

    flags = struct.unpack("!H", data[2:4])[0]
    ancount = struct.unpack("!H", data[6:8])[0]
    is_response = (flags & 0x8000) != 0

    if not is_response or ancount == 0:
        return False

    # Check if the target name appears in the response (handles non-compressed labels)
    target = encode_qname(hostname)
    return target.lower() in data.lower()


def probe(hostname, timeout):
    """Send mDNS query and wait for a matching response. Returns True if found."""
    query = build_query(hostname)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.settimeout(1.0)

    try:
        # Bind to mDNS port to receive multicast responses
        sock.bind(("", MDNS_PORT))
        group = socket.inet_aton(MDNS_ADDR)
        mreq = group + socket.inet_aton("0.0.0.0")
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)

        deadline = time.monotonic() + timeout
        next_send = 0.0

        while time.monotonic() < deadline:
            # Send query (retry every 2 seconds)
            if time.monotonic() >= next_send:
                sock.sendto(query, (MDNS_ADDR, MDNS_PORT))
                next_send = time.monotonic() + 2.0

            try:
                data, addr = sock.recvfrom(1024)
            except socket.timeout:
                continue

            if response_matches(data, hostname):
                return True

        return False
    finally:
        sock.close()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <hostname> [timeout_seconds]", file=sys.stderr)
        sys.exit(2)

    hostname = sys.argv[1]
    timeout = float(sys.argv[2]) if len(sys.argv) > 2 else 10.0

    try:
        found = probe(hostname, timeout)
    except Exception as e:
        print(f"mDNS probe error: {e}", file=sys.stderr)
        sys.exit(2)

    if found:
        print(f"{hostname}.local found on the network")
        sys.exit(0)
    else:
        print(f"{hostname}.local not found")
        sys.exit(1)
