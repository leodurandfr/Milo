#!/bin/bash
# milo-set-wifi-country — Apply WiFi regulatory domain
#
# Usage: milo-set-wifi-country <COUNTRY_CODE>
#   COUNTRY_CODE: exactly two uppercase ASCII letters (e.g. FR, US, GB)
#
# Effects:
#   1. iw reg set <CC>              — sets regulatory domain for current session
#   2. /boot/firmware/cmdline.txt   — persists cfg80211.ieee80211_regdom=<CC>
#
# Must be run as root (via sudoers rule).
#
# Twin of milo-client/rootfs/usr/local/bin/milo-set-wifi-country — a satellite
# applies the server's country when it joins the server's WiFi.

set -euo pipefail

CMDLINE_FILE="/boot/firmware/cmdline.txt"
# Not on cmdline.txt itself: the rename below gives that path a new inode.
LOCK_FILE="/run/lock/milo-set-wifi-country.lock"

# Fallback for older Pi OS layouts
if [[ ! -f "$CMDLINE_FILE" ]]; then
    CMDLINE_FILE="/boot/cmdline.txt"
fi

# =============================================================================
# Validation
# =============================================================================

if [[ $# -ne 1 ]]; then
    echo "ERROR: Usage: milo-set-wifi-country <COUNTRY_CODE>" >&2
    exit 1
fi

COUNTRY_CODE="$1"

if ! [[ "$COUNTRY_CODE" =~ ^[A-Z0-9]{2}$ ]]; then
    echo "ERROR: Invalid country code '$COUNTRY_CODE'. Must be two uppercase letters (e.g. FR, US, GB)." >&2
    exit 1
fi

if [[ ! -f "$CMDLINE_FILE" ]]; then
    echo "ERROR: $CMDLINE_FILE not found" >&2
    exit 1
fi

# Two runs at once (the setup wizard's mount and its picker) each read the file
# the other was rewriting, and could leave the radio on one country and the
# next boot on the other: serialize the whole change, and read under the lock.
exec 9>"$LOCK_FILE"
if ! flock -w 10 9; then
    echo "ERROR: another milo-set-wifi-country still holds $LOCK_FILE" >&2
    exit 1
fi

CURRENT=$(cat "$CMDLINE_FILE")

# Without root= the next boot finds no root filesystem: never write that back,
# and change nothing else either.
if ! [[ "$CURRENT" =~ (^|[[:space:]])root= ]]; then
    echo "ERROR: $CMDLINE_FILE is empty or carries no root=, left untouched" >&2
    exit 1
fi

# =============================================================================
# Apply regulatory domain for current session
# =============================================================================

if ! iw reg set "$COUNTRY_CODE"; then
    echo "ERROR: 'iw reg set $COUNTRY_CODE' failed" >&2
    exit 1
fi

echo "Regulatory domain set to $COUNTRY_CODE (current session)"

# =============================================================================
# Persist to cmdline.txt for next boot
# =============================================================================

if [[ "$CURRENT" =~ (^|[[:space:]])cfg80211\.ieee80211_regdom=$COUNTRY_CODE([[:space:]]|$) ]]; then
    echo "cmdline.txt already carries cfg80211.ieee80211_regdom=$COUNTRY_CODE"
    exit 0
fi

if echo "$CURRENT" | grep -q "cfg80211.ieee80211_regdom="; then
    NEW_CONTENT=$(echo "$CURRENT" | sed "s/cfg80211\.ieee80211_regdom=[A-Z0-9]*/cfg80211.ieee80211_regdom=$COUNTRY_CODE/")
else
    NEW_CONTENT="${CURRENT% } cfg80211.ieee80211_regdom=$COUNTRY_CODE"
fi

# The boot partition is vfat, with no journal: a file truncated in place and
# cut by a power loss before writeback is a unit that no longer boots. Write a
# sibling, flush it, rename it over, then flush the partition and the file
# (syncfs sends no cache flush on vfat, the file's fsync does).
TMP="$CMDLINE_FILE.milo-new"
trap 'rm -f "$TMP"' EXIT
printf '%s\n' "$NEW_CONTENT" > "$TMP"
sync "$TMP"
mv -f "$TMP" "$CMDLINE_FILE"
sync -f "$CMDLINE_FILE"
sync "$CMDLINE_FILE"

echo "cmdline.txt updated with cfg80211.ieee80211_regdom=$COUNTRY_CODE"
