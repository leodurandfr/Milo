#!/bin/bash
# milo-apply-hardware — Apply hardware configuration and reboot
#
# Reads /var/lib/milo/hardware.json and updates /boot/firmware/config.txt
# with the correct dtoverlay for audio and screen parameters.
# Must be run as root (via sudoers rule).
#
# Managed blocks in config.txt:
#   # BEGIN MILO AUDIO ... # END MILO AUDIO
#   # BEGIN MILO SCREEN ... # END MILO SCREEN

set -euo pipefail

HARDWARE_FILE="/var/lib/milo/hardware.json"
CONFIG_FILE="/boot/firmware/config.txt"

# Fallback for older Pi OS
if [[ ! -f "$CONFIG_FILE" ]]; then
    CONFIG_FILE="/boot/config.txt"
fi

# =============================================================================
# Validation
# =============================================================================

if [[ ! -f "$HARDWARE_FILE" ]]; then
    echo "ERROR: $HARDWARE_FILE not found" >&2
    exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: $CONFIG_FILE not found" >&2
    exit 1
fi

# Validate JSON
if ! python3 -c "import json, sys; json.load(sys.stdin)" < "$HARDWARE_FILE" 2>/dev/null; then
    echo "ERROR: $HARDWARE_FILE is not valid JSON" >&2
    exit 1
fi

# =============================================================================
# Parse hardware.json
# =============================================================================

read_json() {
    python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
keys = sys.argv[2].split('.')
val = data
for k in keys:
    val = val.get(k, '') if isinstance(val, dict) else ''
print(val if val is not None else '')
" "$HARDWARE_FILE" "$1"
}

AUDIO_OVERLAY=$(read_json "audio.overlay")
SCREEN_TYPE=$(read_json "screen.type")

# Validate audio overlay against allowlist
VALID_OVERLAYS="hifiberry-dacplus-std hifiberry-amp4pro hifiberry-amp100 hifiberry-dac hifiberry-dacplushd hifiberry-dacplus"

if [[ -n "$AUDIO_OVERLAY" ]]; then
    if ! echo "$VALID_OVERLAYS" | grep -qw "$AUDIO_OVERLAY"; then
        echo "ERROR: Unknown audio overlay '$AUDIO_OVERLAY'" >&2
        exit 1
    fi
fi

# Validate screen type against allowlist
VALID_SCREENS="waveshare_7_usb waveshare_8_dsi none"
if [[ -n "$SCREEN_TYPE" ]]; then
    if ! echo "$VALID_SCREENS" | grep -qw "$SCREEN_TYPE"; then
        echo "ERROR: Unknown screen type '$SCREEN_TYPE'" >&2
        exit 1
    fi
fi

# =============================================================================
# Backup config.txt
# =============================================================================

cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d_%H%M%S)"

# =============================================================================
# Helper: remove managed block
# =============================================================================

remove_block() {
    local tag="$1"
    sed -i "/^# BEGIN $tag$/,/^# END $tag$/d" "$CONFIG_FILE"
}

# =============================================================================
# Audio configuration
# =============================================================================

# Remove previous managed audio block
remove_block "MILO AUDIO"

# Remove any legacy (non-managed) hifiberry overlays
for overlay in $VALID_OVERLAYS; do
    sed -i "/^dtoverlay=$overlay$/d" "$CONFIG_FILE"
done

# Remove legacy comment lines from install.sh
sed -i '/^# Milo - HiFiBerry Audio/d' "$CONFIG_FILE"

# Disable built-in audio
sed -i '/^dtparam=audio=on$/d' "$CONFIG_FILE"

# Disable GPU audio on vc4 overlays
if grep -q "vc4-fkms-v3d" "$CONFIG_FILE"; then
    sed -i 's/dtoverlay=vc4-fkms-v3d.*/dtoverlay=vc4-fkms-v3d,audio=off/' "$CONFIG_FILE"
fi
if grep -q "vc4-kms-v3d" "$CONFIG_FILE"; then
    sed -i 's/dtoverlay=vc4-kms-v3d.*/dtoverlay=vc4-kms-v3d,noaudio/' "$CONFIG_FILE"
fi

# Write new audio block
if [[ -n "$AUDIO_OVERLAY" ]]; then
    cat >> "$CONFIG_FILE" << EOF

# BEGIN MILO AUDIO
dtoverlay=$AUDIO_OVERLAY
# END MILO AUDIO
EOF
fi

# =============================================================================
# Screen configuration
# =============================================================================

# Remove previous managed screen block
remove_block "MILO SCREEN"

# Remove legacy HDMI params (from old installs without managed blocks)
for param in hdmi_force_hotplug hdmi_blanking hdmi_group hdmi_mode hdmi_cvt framebuffer_width framebuffer_height; do
    sed -i "/^${param}=/d" "$CONFIG_FILE"
done

# Remove legacy DSI overlay (from old installs without managed blocks)
sed -i '/^dtoverlay=vc4-kms-dsi-waveshare-panel/d' "$CONFIG_FILE"

# Write screen-specific config
case "$SCREEN_TYPE" in
    waveshare_7_usb)
        cat >> "$CONFIG_FILE" << EOF

# BEGIN MILO SCREEN
hdmi_force_hotplug=1
hdmi_blanking=1
hdmi_group=2
hdmi_mode=87
hdmi_cvt=1024 600 60 6 0 0 0
framebuffer_width=1024
framebuffer_height=600
# END MILO SCREEN
EOF
        ;;
    waveshare_8_dsi)
        cat >> "$CONFIG_FILE" << EOF

# BEGIN MILO SCREEN
dtoverlay=vc4-kms-dsi-waveshare-panel,8_0_inch
# END MILO SCREEN
EOF
        ;;
    none|"")
        # No screen configuration needed
        ;;
esac

# Ensure usb_max_current_enable is present
if ! grep -q "usb_max_current_enable=1" "$CONFIG_FILE"; then
    echo "usb_max_current_enable=1" >> "$CONFIG_FILE"
fi

# =============================================================================
# Reboot
# =============================================================================

echo "Hardware configuration applied. Rebooting..."
/sbin/reboot
