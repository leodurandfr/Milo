#!/bin/bash
# milo-set-password — Set the `milo` account password (SSH login + sudo)
#
# Usage: printf '%s' "<password>" | milo-set-password
#
# The password is read from **stdin, never argv**: /proc/<pid>/cmdline is
# world-readable, so a password passed as an argument is visible to every
# process on the box for as long as this one lives.
#
# Effects:
#   1. chpasswd on the `milo` account
#   2. creates /var/lib/milo/password-changed
#
# That marker is the whole point of this helper existing rather than the
# backend shelling chpasswd itself. The image ships a factory password that is
# the same on every unit, which is safe only as long as it is a *local*
# convenience: SSH is the one remote path that uses it, and the backend refuses
# to enable ssh.service while this marker is absent. A password set by any
# other route would leave the marker absent and the SSH switch dead, which is
# the safe direction.
#
# Must be run as root (via sudoers rule).

set -euo pipefail

TARGET_USER="milo"
MARKER="/var/lib/milo/password-changed"
MIN_LENGTH=8
MAX_LENGTH=128

if ! id "$TARGET_USER" &>/dev/null; then
    echo "ERROR: user '$TARGET_USER' does not exist" >&2
    exit 1
fi

# A terminal on stdin means the caller passed nothing to read; `read` would
# block forever holding a sudo session open.
if [[ -t 0 ]]; then
    echo "ERROR: the password must be piped on stdin" >&2
    exit 1
fi

IFS= read -r PASSWORD || true

if (( ${#PASSWORD} < MIN_LENGTH )); then
    echo "ERROR: password must be at least $MIN_LENGTH characters" >&2
    exit 1
fi

if (( ${#PASSWORD} > MAX_LENGTH )); then
    echo "ERROR: password must be at most $MAX_LENGTH characters" >&2
    exit 1
fi

# `read` already stopped at the first newline, so only the other control
# characters can still be in there. They survive the round-trip through JSON
# and would land in the shadow entry unnoticed.
if [[ "$PASSWORD" =~ [^[:print:]] ]]; then
    echo "ERROR: password contains a non-printable character" >&2
    exit 1
fi

printf '%s:%s\n' "$TARGET_USER" "$PASSWORD" | chpasswd

mkdir -p "$(dirname "$MARKER")"
: > "$MARKER"
chmod 0644 "$MARKER"

echo "Password updated for $TARGET_USER"
