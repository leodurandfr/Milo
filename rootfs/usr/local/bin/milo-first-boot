#!/bin/bash
# milo-first-boot — Auto-detect device mode on each boot until role is locked.
#
# Runs before avahi-daemon to avoid claiming milo.local while another
# Milo server already owns it on the network.
#
# Idempotent flow (re-evaluated on every boot until setup_completed=true):
#   - milo.local found on LAN  + hostname=milo        → configure_client (reboot)
#   - milo.local found on LAN  + hostname=milo-client → no-op (already client)
#   - milo.local not found     + hostname=milo        → no-op (already server)
#   - milo.local not found     + hostname=milo-client → configure_server (reboot, revert)
#   - no ethernet IP available                         → no-op (cannot probe)
#
# Skips entirely once setup_completed is true in settings.json. That flag is
# written by the server wizard or by the milo-client hardware-apply handler
# once the user has fully configured the device.
#
# Must be run as root (systemd service).

set -euo pipefail

MILO_DATA_DIR="/var/lib/milo"
MILO_APP_DIR="/home/milo/milo"

MILO_CLIENT_USER="milo-client"
MILO_CLIENT_HOME="/home/$MILO_CLIENT_USER"
MILO_CLIENT_DATA_DIR="/var/lib/milo-client"

# Active ethernet IPv4 address, populated by wait_for_ethernet_ip
ETH_IP=""

log() { echo "[milo-first-boot] $1"; }

# Setup already completed (wizard finished or client configured) — nothing to do
if python3 -c "
import json, sys
try:
    d = json.load(open('${MILO_DATA_DIR}/settings.json'))
    sys.exit(0 if d.get('setup_completed') else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
    exit 0
fi

# =============================================================================
# Check for ethernet connection
# =============================================================================

has_ethernet_carrier() {
    # Check if an ethernet cable is physically plugged in.
    # On cold boot the carrier can take 10+ seconds to appear after
    # NetworkManager starts, so we poll for up to max_wait seconds.
    local max_wait=${1:-0}
    local waited=0

    while true; do
        for iface in /sys/class/net/eth* /sys/class/net/end*; do
            if [[ -f "$iface/carrier" ]] && [[ "$(cat "$iface/carrier" 2>/dev/null)" == "1" ]]; then
                return 0
            fi
        done

        if (( waited >= max_wait )); then
            return 1
        fi

        sleep 1
        waited=$((waited + 1))
    done
}

wait_for_ethernet_ip() {
    # Ethernet carrier is present — wait for DHCP to assign an IP (max 15s).
    # On success, populates ETH_IP with the assigned IPv4 address so the
    # mDNS probe can bind multicast send/receive to that interface.
    local max_wait=15
    local waited=0

    while (( waited < max_wait )); do
        for iface in /sys/class/net/eth* /sys/class/net/end*; do
            [[ -f "$iface/carrier" ]] || continue
            [[ "$(cat "$iface/carrier" 2>/dev/null)" == "1" ]] || continue
            local name
            name=$(basename "$iface")
            local ip
            ip=$(ip -4 -o addr show "$name" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
            if [[ -n "$ip" ]]; then
                ETH_IP="$ip"
                log "Network ready on $name (ip=$ip)"
                return 0
            fi
        done

        sleep 1
        waited=$((waited + 1))
    done

    log "Ethernet carrier present but no IP after ${max_wait}s"
    return 1
}

# =============================================================================
# Configure as milo-client
# =============================================================================

configure_client() {
    log "Configuring as milo-client..."

    # 1. Set hostname
    hostnamectl set-hostname milo-client
    echo "milo-client" > /etc/hostname
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/127.0.1.1.*/127.0.1.1\tmilo-client/" /etc/hosts
    else
        echo -e "127.0.1.1\tmilo-client" >> /etc/hosts
    fi
    log "Hostname set to milo-client"

    # 2. Create milo-client user
    if ! id "$MILO_CLIENT_USER" &>/dev/null; then
        useradd -m -s /bin/bash -G audio,sudo "$MILO_CLIENT_USER"
        log "User $MILO_CLIENT_USER created"
    fi

    # 3. Set up repo structure (symlink to pre-installed files)
    # chown BEFORE creating symlinks to avoid traversing into shared source tree
    local repo_dir="$MILO_CLIENT_HOME/repo"
    mkdir -p "$repo_dir"
    chown -R "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_HOME"
    ln -sfn "$MILO_APP_DIR/milo-client" "$repo_dir/milo-client"
    chown -h "$MILO_CLIENT_USER:audio" "$repo_dir/milo-client"
    log "Repo structure linked"

    # 4. Set up venv (symlink to pre-built venv)
    ln -sfn "$MILO_APP_DIR/milo-client/venv" "$MILO_CLIENT_HOME/venv"
    chown -h "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_HOME/venv"
    log "Venv linked"

    # 5. Create data directory with env and hardware config
    mkdir -p "$MILO_CLIENT_DATA_DIR"

    cat > "$MILO_CLIENT_DATA_DIR/env" << 'EOF'
MILO_PRINCIPAL_IP=milo.local
MILO_CLIENT_DSP_ENABLED=false
EOF

    cat > "$MILO_CLIENT_DATA_DIR/hardware.json" << 'EOF'
{
  "audio": {
    "id": "none"
  }
}
EOF

    chown -R "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_DATA_DIR"
    log "Client data directory created"

    # 6. Set up CamillaDSP config
    mkdir -p "$MILO_CLIENT_DATA_DIR/camilladsp/configs"
    if [[ -f "$MILO_APP_DIR/milo-client/configs/camilladsp/config.yml" ]]; then
        cp "$MILO_APP_DIR/milo-client/configs/camilladsp/config.yml" \
            "$MILO_CLIENT_DATA_DIR/camilladsp/config.yml"
        chown -R "$MILO_CLIENT_USER:$MILO_CLIENT_USER" "$MILO_CLIENT_DATA_DIR/camilladsp"
    fi
    log "CamillaDSP config deployed"

    # 7. Deploy client ALSA configuration (replace server asound.conf)
    if [[ -f "$MILO_APP_DIR/milo-client/rootfs/etc/asound.conf" ]]; then
        cp "$MILO_APP_DIR/milo-client/rootfs/etc/asound.conf" /etc/asound.conf
        log "Client ALSA config deployed"
    fi

    # Deploy client loopback module options (2 substreams instead of server's 8)
    if [[ -f "$MILO_APP_DIR/milo-client/rootfs/etc/modprobe.d/milo-client-loopback.conf" ]]; then
        cp "$MILO_APP_DIR/milo-client/rootfs/etc/modprobe.d/milo-client-loopback.conf" /etc/modprobe.d/
        log "Client loopback config deployed"
    fi

    # 8. Disable server-only services
    local server_services=(
        milo-backend
        milo-kiosk
        milo-readiness
        milo-bluealsa
        milo-bluealsa-aplay
        milo-camilladsp
        nginx
    )
    for svc in "${server_services[@]}"; do
        systemctl disable "$svc.service" 2>/dev/null || true
    done
    log "Server services disabled"

    # 9. Enable client services
    local client_services=(
        milo-client
        milo-client-snapclient
        milo-client-camilladsp
    )
    for svc in "${client_services[@]}"; do
        systemctl enable "$svc.service" 2>/dev/null || log "Warning: could not enable $svc"
    done
    log "Client services enabled"

    # 10. Hand /var/lib/milo to milo-client (the milo user is unused on a client).
    # setup_completed is intentionally NOT written here — it is set only after the
    # user finishes configuration via the milo-client hardware-apply handler.
    chown -R "$MILO_CLIENT_USER:audio" "$MILO_DATA_DIR"

    log "Client configuration complete — rebooting"
    /sbin/reboot
}

# =============================================================================
# Configure as milo (server) — revert from milo-client
# =============================================================================

configure_server() {
    log "Reverting to milo server..."

    # 1. Set hostname back to milo
    hostnamectl set-hostname milo
    echo "milo" > /etc/hostname
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/127.0.1.1.*/127.0.1.1\tmilo/" /etc/hosts
    else
        echo -e "127.0.1.1\tmilo" >> /etc/hosts
    fi
    log "Hostname set to milo"

    # 2. Restore server ALSA configuration
    if [[ -f "$MILO_APP_DIR/rootfs/etc/asound.conf" ]]; then
        cp "$MILO_APP_DIR/rootfs/etc/asound.conf" /etc/asound.conf
        log "Server ALSA config restored"
    else
        log "Warning: server asound.conf not found at $MILO_APP_DIR/rootfs/etc/asound.conf"
    fi

    # 3. Remove client loopback module options (server uses defaults / its own)
    if [[ -f /etc/modprobe.d/milo-client-loopback.conf ]]; then
        rm -f /etc/modprobe.d/milo-client-loopback.conf
        log "Client loopback config removed"
    fi

    # 4. Disable client services
    local client_services=(
        milo-client
        milo-client-snapclient
        milo-client-camilladsp
    )
    for svc in "${client_services[@]}"; do
        systemctl disable "$svc.service" 2>/dev/null || true
    done
    log "Client services disabled"

    # 5. Re-enable server services
    local server_services=(
        milo-backend
        milo-kiosk
        milo-readiness
        milo-bluealsa
        milo-bluealsa-aplay
        milo-camilladsp
        nginx
    )
    for svc in "${server_services[@]}"; do
        systemctl enable "$svc.service" 2>/dev/null || log "Warning: could not enable $svc"
    done
    log "Server services enabled"

    # 6. Reset server data directory (backend will recreate settings.json with defaults).
    # /var/lib/milo-client, the milo-client user and its symlinks are left in place:
    # they are inert on a server and avoid extra teardown work.
    rm -f "$MILO_DATA_DIR/settings.json"
    chown -R milo:milo "$MILO_DATA_DIR"
    log "Server data directory reset"

    log "Server configuration complete — rebooting"
    /sbin/reboot
}

# =============================================================================
# Main
# =============================================================================

current_hostname=$(hostname)
log "Setup not completed (hostname=$current_hostname) — detecting role..."

if has_ethernet_carrier 15 && wait_for_ethernet_ip; then
    # Let multicast/IGMP fully settle on the freshly-up interface before probing
    sleep 5

    # Probe up to 3 times to handle transient network conditions
    # (lost packets, switch IGMP snooping warm-up, peer not yet responding).
    milo_local_found=false
    for attempt in 1 2 3; do
        if /usr/bin/python3 /usr/local/bin/milo-mdns-probe milo 10 "$ETH_IP"; then
            milo_local_found=true
            break
        fi
        if (( attempt < 3 )); then
            log "Probe attempt $attempt did not find milo.local — retrying"
            sleep 3
        fi
    done

    if $milo_local_found; then
        if [[ "$current_hostname" != "milo-client" ]]; then
            configure_client  # reboots
        else
            log "milo.local found and already a client — no action"
        fi
    else
        if [[ "$current_hostname" == "milo-client" ]]; then
            log "milo.local gone but hostname is milo-client — reverting to server"
            configure_server  # reboots
        else
            log "No milo.local found — staying as server (wizard will appear)"
        fi
    fi
else
    log "No ethernet IP available — cannot probe, no role change"
fi

exit 0
