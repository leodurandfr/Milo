#!/bin/bash
# milo-first-boot — Auto-detect device mode on each boot until role is locked.
#
# Runs before avahi-daemon to avoid claiming milo.local while another
# Milo server already owns it on the network.
#
# Idempotent flow (re-evaluated on every boot until setup_completed=true):
#   - milo.local found on LAN  + hostname=milo        → configure_client (reboot)
#   - milo.local found on LAN  + hostname=milo-client → no-op (already client)
#   - milo.local not found     + hostname=milo        → no-op (already server)
#   - milo.local not found     + hostname=milo-client → configure_server (reboot, revert)
#   - no ethernet IP available                         → no-op (cannot probe)
#
# Skips entirely once setup_completed is true in settings.json. That flag is
# written by the server wizard or by the milo-client hardware-apply handler
# once the user has fully configured the device.
#
# Must be run as root (systemd service).

set -euo pipefail

MILO_DATA_DIR="/var/lib/milo"
MILO_APP_DIR="/home/milo/milo"
PENDING_CLIENT_ROLE_FILE="$MILO_DATA_DIR/pending_client_role.json"

MILO_CLIENT_USER="milo-client"
MILO_CLIENT_HOME="/home/$MILO_CLIENT_USER"
MILO_CLIENT_DATA_DIR="/var/lib/milo-client"

# Setup hotspot SSID — must match HOTSPOT_NAME in backend/core/network/service.py
# and is_hotspot_connection() in the 90-milo-network dispatcher.
HOTSPOT_SSID="Milō"
AVAHI_STATE_FILE="$MILO_DATA_DIR/avahi-interface"

# Active ethernet IPv4 address, populated by wait_for_ethernet_ip
ETH_IP=""

log() { echo "[milo-first-boot] $1"; }

# Install the avahi interface-override drop-in matching the active role, and
# remove the other one. The two must never coexist: the client drop-in's static
# allow/deny sed would fight the server's dynamic interface selection.
#
# Installing — not only pruning — is what makes every path into a role correct.
# Only pi-gen ships both drop-ins; install.sh ships the server's alone, so a
# device it installed and this script then converted to client was left with NO
# drop-in at all. Nothing reset allow-interfaces at boot, and the wlan0 written
# by the dispatcher during the setup hotspot survived every reboot, leaving avahi
# bound to a down interface: no mDNS, so the satellite could not resolve
# milo.local and never registered with the server — silently, with no error on
# either side.
#
# Runs before avahi-daemon starts (see the header), so the drop-in is in place
# for its ExecStartPre; no restart needed here.
# Idempotent — safe to call on every boot, and repairs a drifted drop-in.
apply_avahi_override() {
    local role="$1"  # server | client
    local dir="/etc/systemd/system/avahi-daemon.service.d"
    local keep drop src

    if [[ "$role" == "client" ]]; then
        keep="milo-client-override.conf"
        drop="milo-override.conf"
        src="$MILO_APP_DIR/milo-client/system/avahi-daemon-override.conf"
    else
        keep="milo-override.conf"
        drop="milo-client-override.conf"
        src="$MILO_APP_DIR/system/avahi-daemon-override.conf"
    fi

    mkdir -p "$dir"
    rm -f "$dir/$drop"
    if [[ -f "$src" ]]; then
        cp "$src" "$dir/$keep"
    else
        log "WARNING: $src missing — avahi override for role $role not installed"
    fi
    systemctl daemon-reload 2>/dev/null || true
}

# =============================================================================
# Setup-phase network reset
# =============================================================================

# Drop the setup hotspot's NetworkManager profile, if any. The backend
# re-creates it seconds later (maybe_start_hotspot) iff the device really has
# no network, so the AP is always a decision of the current boot and never an
# inheritance from the previous one.
delete_hotspot_profile() {
    nmcli -t -f NAME connection show 2>/dev/null | grep -qxF "$HOTSPOT_SSID" || return 0
    if nmcli connection delete "$HOTSPOT_SSID" >/dev/null 2>&1; then
        log "Setup hotspot profile removed"
    else
        log "Warning: could not remove the setup hotspot profile"
    fi
}

# While setup is incomplete, every boot starts from a clean network slate.
# Saved WiFi *client* profiles are deliberately left alone: the wizard writes
# one before setup_completed flips, and a power cut mid-wizard must not lose
# the credentials the user just typed.
reset_setup_network_state() {
    delete_hotspot_profile

    # An AP inherited from a previous boot pins Avahi to wlan0 (the hotspot rule
    # in 90-milo-network), which hides the device from the LAN entirely. Avahi
    # has not started yet here — milo-apply-avahi-iface reads this file in its
    # ExecStartPre — so writing the file is enough. The dispatcher flips it back
    # to wlan0 on its own if the backend does bring the hotspot up.
    if [[ "$(cat "$AVAHI_STATE_FILE" 2>/dev/null)" != "eth0" ]]; then
        mkdir -p "$MILO_DATA_DIR"
        echo "eth0" > "$AVAHI_STATE_FILE"
        log "Avahi interface state reset to eth0"
    fi
}

# =============================================================================
# Check for ethernet connection
# =============================================================================

has_ethernet_carrier() {
    # Check if an ethernet cable is physically plugged in.
    # On cold boot the carrier can take 10+ seconds to appear after
    # NetworkManager starts, so we poll for up to max_wait seconds.
    local max_wait=${1:-0}
    local waited=0

    while true; do
        for iface in /sys/class/net/eth* /sys/class/net/end*; do
            if [[ -f "$iface/carrier" ]] && [[ "$(cat "$iface/carrier" 2>/dev/null)" == "1" ]]; then
                return 0
            fi
        done

        if (( waited >= max_wait )); then
            return 1
        fi

        sleep 1
        waited=$((waited + 1))
    done
}

wait_for_ethernet_ip() {
    # Ethernet carrier is present — wait for DHCP to assign an IP.
    # On success, populates ETH_IP with the assigned IPv4 address so the
    # mDNS probe can bind multicast send/receive to that interface.
    #
    # The budget matches NetworkManager's own dhcp4 transaction timeout: a link
    # renegotiation mid-transaction makes NM cancel and restart the lease
    # request from zero ("ip:dhcp4: restarting"), so a lease can legitimately
    # arrive ~20 s after the carrier came up. Losing that race is silent and
    # expensive — the device skips role detection and stays a server forever.
    # A carrier bounce re-arms the budget, bounded by hard_cap so the whole
    # unit stays well inside its TimeoutStartSec.
    local max_wait=45
    local hard_cap=75
    local elapsed=0
    local since_carrier=0
    local had_carrier=true

    while (( since_carrier < max_wait && elapsed < hard_cap )); do
        local carrier_up=false

        for iface in /sys/class/net/eth* /sys/class/net/end*; do
            [[ -f "$iface/carrier" ]] || continue
            [[ "$(cat "$iface/carrier" 2>/dev/null)" == "1" ]] || continue
            carrier_up=true
            local name
            name=$(basename "$iface")
            local ip
            ip=$(ip -4 -o addr show "$name" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
            if [[ -n "$ip" ]]; then
                ETH_IP="$ip"
                log "Network ready on $name (ip=$ip)"
                return 0
            fi
        done

        if ! $carrier_up; then
            had_carrier=false
        elif ! $had_carrier; then
            had_carrier=true
            since_carrier=0
            log "Ethernet carrier bounced — restarting the DHCP wait"
        fi

        sleep 1
        elapsed=$((elapsed + 1))
        since_carrier=$((since_carrier + 1))
    done

    log "Ethernet carrier present but no IP after ${elapsed}s"
    return 1
}

# =============================================================================
# Configure as milo-client
# =============================================================================

# Apply all client-role filesystem changes (hostname, user, services, ALSA).
# Idempotent — safe to call on a device that is already a client.
# Does NOT write hardware.json / identity.json (callers handle those) and does
# NOT reboot — that is the caller's responsibility.
_apply_client_filesystem() {
    # 1. Set hostname
    hostnamectl set-hostname milo-client
    echo "milo-client" > /etc/hostname
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/127.0.1.1.*/127.0.1.1\tmilo-client/" /etc/hosts
    else
        echo -e "127.0.1.1\tmilo-client" >> /etc/hosts
    fi
    log "Hostname set to milo-client"

    # 2. Create milo-client user
    if ! id "$MILO_CLIENT_USER" &>/dev/null; then
        useradd -m -s /bin/bash -G audio,sudo "$MILO_CLIENT_USER"
        log "User $MILO_CLIENT_USER created"
    fi

    # 3. Set up repo structure (symlink to pre-installed files)
    # chown BEFORE creating symlinks to avoid traversing into shared source tree
    local repo_dir="$MILO_CLIENT_HOME/repo"
    mkdir -p "$repo_dir"
    chown -R "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_HOME"
    ln -sfn "$MILO_APP_DIR/milo-client" "$repo_dir/milo-client"
    chown -h "$MILO_CLIENT_USER:audio" "$repo_dir/milo-client"
    log "Repo structure linked"

    # 4. Set up venv (symlink to pre-built venv)
    ln -sfn "$MILO_APP_DIR/milo-client/venv" "$MILO_CLIENT_HOME/venv"
    chown -h "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_HOME/venv"
    log "Venv linked"

    # 5. Create data directory with env file
    mkdir -p "$MILO_CLIENT_DATA_DIR"

    cat > "$MILO_CLIENT_DATA_DIR/env" << 'EOF'
MILO_PRINCIPAL_IP=milo.local
MILO_CLIENT_DSP_ENABLED=false
EOF

    # 6. Set up CamillaDSP config
    mkdir -p "$MILO_CLIENT_DATA_DIR/camilladsp/configs"
    if [[ -f "$MILO_APP_DIR/milo-client/configs/camilladsp/config.yml" ]]; then
        cp "$MILO_APP_DIR/milo-client/configs/camilladsp/config.yml" \
            "$MILO_CLIENT_DATA_DIR/camilladsp/config.yml"
        chown -R "$MILO_CLIENT_USER:$MILO_CLIENT_USER" "$MILO_CLIENT_DATA_DIR/camilladsp"
    fi
    log "CamillaDSP config deployed"

    # 7. Deploy client ALSA configuration (replace server asound.conf)
    if [[ -f "$MILO_APP_DIR/milo-client/rootfs/etc/asound.conf" ]]; then
        cp "$MILO_APP_DIR/milo-client/rootfs/etc/asound.conf" /etc/asound.conf
        log "Client ALSA config deployed"
    fi

    # Deploy client loopback module options (2 substreams instead of server's 8)
    if [[ -f "$MILO_APP_DIR/milo-client/rootfs/etc/modprobe.d/milo-client-loopback.conf" ]]; then
        cp "$MILO_APP_DIR/milo-client/rootfs/etc/modprobe.d/milo-client-loopback.conf" /etc/modprobe.d/
        log "Client loopback config deployed"
    fi

    # 8. Disable server-only services
    local server_services=(
        milo-backend
        milo-kiosk
        milo-readiness
        milo-bluealsa
        milo-bluealsa-aplay
        milo-camilladsp
        nginx
    )
    for svc in "${server_services[@]}"; do
        systemctl disable "$svc.service" 2>/dev/null || true
    done
    log "Server services disabled"

    # 8b. Install the client avahi override (and drop the server one)
    apply_avahi_override client

    # 8c. A client has no backend left to clean up after the setup hotspot. The
    # wifi-adoption path reaches here with setup_completed already true, so
    # reset_setup_network_state never ran for it.
    delete_hotspot_profile

    # 9. Enable client services
    local client_services=(
        milo-client
        milo-client-snapclient
        milo-client-camilladsp
    )
    for svc in "${client_services[@]}"; do
        systemctl enable "$svc.service" 2>/dev/null || log "Warning: could not enable $svc"
    done
    log "Client services enabled"

    # 10. Lock the role early, then hand /var/lib/milo to milo-client.
    # setup_completed=true is written here so milo-first-boot skips re-detection on
    # subsequent boots, even if the user hasn't yet picked an audio card via the UI.
    # Without this, a transient mDNS failure (LAN flake, switch IGMP warm-up,
    # server reboot) could trigger configure_server and revert this device.
    /usr/bin/python3 << PY
import json
import os

path = "$MILO_DATA_DIR/settings.json"
try:
    with open(path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}
data["setup_completed"] = True
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.flush()
    os.fsync(f.fileno())
os.replace(tmp, path)
PY
    chown -R "$MILO_CLIENT_USER:audio" "$MILO_DATA_DIR"
}

configure_client() {
    log "Configuring as milo-client..."

    _apply_client_filesystem

    # Default hardware config — user will pick the audio card via the milo-client UI.
    cat > "$MILO_CLIENT_DATA_DIR/hardware.json" << 'EOF'
{
  "audio": {
    "id": "none"
  }
}
EOF
    chown -R "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_DATA_DIR"
    log "Client data directory created"

    log "Client configuration complete — rebooting"
    /sbin/reboot
}

# Apply client role with the audio + identity values from the wifi-adoption marker
# left by the server's POST /api/setup/become-client endpoint.
configure_client_with_hardware() {
    log "Configuring as milo-client with adopted hardware..."

    _apply_client_filesystem

    # Read marker, write hardware.json + identity.json, then drop the marker so
    # subsequent boots return to the standard skip-check fast-path.
    if ! /usr/bin/python3 << PY
import json
import os
import sys

marker_path = "$PENDING_CLIENT_ROLE_FILE"
client_dir = "$MILO_CLIENT_DATA_DIR"

try:
    with open(marker_path) as f:
        m = json.load(f)
except Exception as e:
    print(f"Failed to read marker: {e}", file=sys.stderr)
    sys.exit(1)

required = ("audio_id", "overlay", "volume_control", "speaker_name", "speaker_type")
for key in required:
    if key not in m:
        print(f"Marker missing required key: {key}", file=sys.stderr)
        sys.exit(1)

audio = {"id": m["audio_id"]}
if m["audio_id"] != "none":
    audio["overlay"] = m["overlay"]
    audio["volume_control"] = bool(m["volume_control"])

def atomic_write(path: str, data: dict) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)

atomic_write(f"{client_dir}/hardware.json", {"audio": audio})
atomic_write(
    f"{client_dir}/identity.json",
    {"name": m["speaker_name"], "speaker_type": m["speaker_type"]},
)

os.remove(marker_path)
PY
    then
        log "ERROR: failed to apply marker — leaving marker in place for retry"
        exit 1
    fi

    chown -R "$MILO_CLIENT_USER:audio" "$MILO_CLIENT_DATA_DIR"
    log "Hardware + identity written from marker, marker removed"

    log "Client configuration with adopted hardware complete — rebooting"
    /sbin/reboot
}

# =============================================================================
# Configure as milo (server) — revert from milo-client
# =============================================================================

configure_server() {
    log "Reverting to milo server..."

    # Hostname change is intentionally LAST: until it flips back to "milo", the
    # client→server trigger condition (hostname=milo-client + no milo.local) stays
    # true, so an interrupted revert (power loss mid-run) is retried on next boot.

    # 1. Restore server ALSA configuration
    if [[ -f "$MILO_APP_DIR/rootfs/etc/asound.conf" ]]; then
        cp "$MILO_APP_DIR/rootfs/etc/asound.conf" /etc/asound.conf
        log "Server ALSA config restored"
    else
        log "Warning: server asound.conf not found at $MILO_APP_DIR/rootfs/etc/asound.conf"
    fi

    # 2. Remove client loopback module options (server uses defaults / its own)
    if [[ -f /etc/modprobe.d/milo-client-loopback.conf ]]; then
        rm -f /etc/modprobe.d/milo-client-loopback.conf
        log "Client loopback config removed"
    fi

    # 3. Disable client services
    local client_services=(
        milo-client
        milo-client-snapclient
        milo-client-camilladsp
    )
    for svc in "${client_services[@]}"; do
        systemctl disable "$svc.service" 2>/dev/null || true
    done
    log "Client services disabled"

    # 4. Re-enable server services
    local server_services=(
        milo-backend
        milo-kiosk
        milo-readiness
        milo-bluealsa
        milo-bluealsa-aplay
        milo-camilladsp
        nginx
    )
    for svc in "${server_services[@]}"; do
        systemctl enable "$svc.service" 2>/dev/null || log "Warning: could not enable $svc"
    done
    log "Server services enabled"

    # 4b. Install the server avahi override (and drop the client one)
    apply_avahi_override server

    # 5. Reset only settings.json — other data files (radio, podcast, hardware) are
    # inert on a fresh server and will be overwritten when needed.
    # /var/lib/milo-client, the milo-client user and its symlinks are left in place:
    # they are inert on a server and avoid extra teardown work.
    rm -f "$MILO_DATA_DIR/settings.json"
    if [[ -f "$PENDING_CLIENT_ROLE_FILE" ]]; then
        rm -f "$PENDING_CLIENT_ROLE_FILE"
        log "Stale wifi-adoption marker removed"
    fi
    chown -R milo:milo "$MILO_DATA_DIR"
    log "Server data directory reset"

    # 6. Set hostname back to milo (last — see top of function)
    hostnamectl set-hostname milo
    echo "milo" > /etc/hostname
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/127.0.1.1.*/127.0.1.1\tmilo/" /etc/hosts
    else
        echo -e "127.0.1.1\tmilo" >> /etc/hosts
    fi
    log "Hostname set to milo"

    log "Server configuration complete — rebooting"
    /sbin/reboot
}

# =============================================================================
# Main
# =============================================================================

# Setup already completed (wizard finished or client configured).
# One exception: if a wifi-adoption marker was dropped by the server's
# /api/setup/become-client endpoint, apply the client role with the provided
# hardware config now (setup_completed is set to true alongside the marker).
if python3 -c "
import json, sys
try:
    d = json.load(open('${MILO_DATA_DIR}/settings.json'))
    sys.exit(0 if d.get('setup_completed') else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
    if [[ -f "$PENDING_CLIENT_ROLE_FILE" ]]; then
        log "Pending client-role marker found — applying wifi adoption"
        configure_client_with_hardware  # reboots
    fi
    exit 0
fi

current_hostname=$(hostname)
log "Setup not completed (hostname=$current_hostname) — detecting role..."

# Align the avahi override with the current role on every detection boot. The
# fresh-server path stays a server without ever calling configure_server, so this
# is the only place a brand-new image drops the unused client override.
if [[ "$current_hostname" == "milo-client" ]]; then
    apply_avahi_override client
else
    apply_avahi_override server
fi

# Nothing the setup phase puts on the network may outlive the boot that created
# it — otherwise a hotspot raised on a network-less boot keeps broadcasting (and
# keeps mDNS pinned to it) once the device has a real link.
reset_setup_network_state

if has_ethernet_carrier 15 && wait_for_ethernet_ip; then
    # Let multicast/IGMP fully settle on the freshly-up interface before probing
    sleep 5

    # Probe up to 3 times to handle transient network conditions
    # (lost packets, switch IGMP snooping warm-up, peer not yet responding).
    milo_local_found=false
    for attempt in 1 2 3; do
        if /usr/bin/python3 /usr/local/bin/milo-mdns-probe milo 10 "$ETH_IP"; then
            milo_local_found=true
            break
        fi
        if (( attempt < 3 )); then
            log "Probe attempt $attempt did not find milo.local — retrying"
            sleep 3
        fi
    done

    if $milo_local_found; then
        if [[ "$current_hostname" != "milo-client" ]]; then
            configure_client  # reboots
        else
            log "milo.local found and already a client — no action"
        fi
    else
        if [[ "$current_hostname" == "milo-client" ]]; then
            log "milo.local gone but hostname is milo-client — reverting to server"
            configure_server  # reboots
        else
            log "No milo.local found — staying as server (wizard will appear)"
        fi
    fi
else
    log "No ethernet IP available — cannot probe, no role change"
fi

exit 0
