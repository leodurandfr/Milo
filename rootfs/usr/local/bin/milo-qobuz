#!/usr/bin/env python3
"""Run qobuz-proxy with Milō's six adaptations, bound to names instead of to source text.

Milō needs six things upstream does not offer as configuration:

1. **Volume policy.** CamillaDSP is the only attenuation stage in the audio path
   — the role `external_volume` plays for go-librespot and `ignore_volume_control`
   for shairport-sync. qobuz-proxy's local backend has no knob for it
   (`fixed_volume` is DLNA-only) and its stream defaults to 50 %, so the app
   slider would attenuate, and lose bits, before CamillaDSP. The stream keeps
   unity unless `$QOBUZPROXY_DATA_DIR/allow_app_volume` holds `1`, which the
   backend writes from the "allow app volume" setting.

2. **Progress in the local status API.** The proxy tracks position and duration
   and ships both to the Qobuz cloud, but leaves them out of `now_playing` —
   the only surface Milō can read. Without them the player's progress bar never
   moves.

3. **The session as the player holds it.** The status folds the player's state
   into `playing` / `paused` / `idle`, so a track loading (LOADING, ~100 ms at
   every skip, measured), a track that failed (ERROR) and a speaker the app has
   let go of all read `idle`, and Milō could only guess which with timers.
   `player_state` is the player's own state, lowercased, and `renderer_active`
   whether the Qobuz cloud has this speaker as the app's output — the value of
   the server's last SET_ACTIVE, which is how the app picking another output is
   told (measured 2026-09-24). Not upstream's `is_renderer_active`, which also
   drops while the cloud WebSocket reconnects, with the music still playing.

4. **The app told who owns the volume.** The JOIN_SESSION capabilities say
   whether the app controls the level (CONTROLLER) or the device does (DEVICE).
   Upstream advertises DEVICE only for a DLNA renderer at fixed volume, so with
   the flag off the app kept offering a slider that adaptation 1 makes inert.
   It now advertises DEVICE whenever the flag is off — read at join time, which
   is why the backend restarts the sidecar when the setting changes either way.

5. **The web UI behind the backend's request gate.** The web UI listens on
   every interface (:8689) for the phone's OAuth flow, with no middleware, and
   its routes change state: `POST /api/auth/logout` clears the token and stops
   the speaker, `/api/speakers` rewrites `config.yaml`. A page from the internet
   open on a LAN browser could log the account out with a self-submitting form,
   and under DNS rebinding rewrite the config. The gate is `RequestOriginGate`'s
   two rules (backend/api/middleware.py), restated because a rootfs script may
   not import the backend and this venv has neither it nor starlette: 403 to a
   Host that is not one of the unit's names or a private address, and to a
   state-changing method whose Origin is present and not one of those.
   `test_the_qobuz_gate_agrees_with_the_backend_gate` holds the copies equal.
   The OAuth callback carries no `state` upstream, so a login CSRF on
   `/auth/callback` stays out of a Host/Origin gate's reach.

6. **One login at a time.** A login starts the speakers only when none runs,
   and starting one takes ~1.7 s (the mDNS registration), with the discovery
   port bound early. Measured 2026-11-05 (1.7.7): the OAuth callback landed
   twice, 0.9 s apart, both logins found no speaker yet and both started one;
   the second could not bind :8690, and upstream's retry loop, which never
   asks whether the speaker already runs, failed on it every 10/20/40 s until
   a restart, and the app did not show "Milo" again. Serialized, the second login
   waits for the first's start, finds the speaker and starts nothing.

The first three used to be applied by rewriting upstream's installed sources, anchored on
exact lines. qobuz-proxy 1.6.0 moved one of those lines — `"volume"` left the
`now_playing` literal for a conditional assignment, for a DLNA-only feature —
without changing a single name, a single signature or a single key. The update
failed, rolled back, and nothing was wrong with the release: the anchor was
reading formatting.

So the adaptations wrap methods. What they bind to is `Speaker.get_status`,
`AudioOutputStream.set_volume`, the player's state and two progress properties,
the WebSocket manager's `_renderer_active`, the `supports_volume_control`
argument of `ProtocolCodec.encode_join_session` (qobuz-proxy ≥ 1.7.4) and the
`register_routes` that `app.py` builds the web UI with, and the
`_on_auth_token` that web UI hands every login to, which only a real
refactor moves — and `--check` says which one did, before the
service is restarted onto it.

The trade this makes, stated: `set_volume` is replaced whole rather than having
one line rewritten, so a statement upstream later adds to that method is
dropped here in silence, where the old anchored patch would have refused.
Detecting that would mean fingerprinting the method body, which is the
brittleness this replaced. The dependency table's row is what covers it: play
from the Qobuz app and watch the level.

Run by milo-qobuz.service through the venv's own interpreter; every argument is
forwarded to qobuz-proxy untouched.
"""
import asyncio
import functools
import inspect
import ipaddress
import logging
import os
import re
import sys
from urllib.parse import urlsplit

VOLUME_FLAG = "allow_app_volume"
# The player states Milo maps to a session phase (backend/sources/qobuz/source.py).
PLAYER_STATES = {"STOPPED", "PLAYING", "PAUSED", "LOADING", "ERROR"}

# backend/api/middleware.py's, with `milo` for EXPECTED_SERVER_HOSTNAME.
STATE_CHANGING_METHODS = frozenset({"POST", "PUT", "PATCH", "DELETE"})
APPLIANCE_NAME = re.compile(
    r"^(localhost|milo(-\d+)?(\.(local|lan|home|home\.arpa|internal|localdomain))?)$"
)

logger = logging.getLogger("milo_qobuz")


def _mentions_key(func, key):
    """Whether `func` still deals in `key` as a literal.

    Not "builds": a constant is a constant, and reading one is indistinguishable
    from writing one here. That is enough — the function asked about is the one
    that produces the status dict, so a release that stopped mentioning the key
    stopped carrying it.

    Nesting is the part worth handling. A dict display with constant keys
    compiles to BUILD_CONST_KEY_MAP, which parks every key in one tuple inside
    `co_consts`, so a flat membership test reports every version as broken —
    measured on 1.5.0, which builds `now_playing` and was reported as having
    renamed it.
    """
    for const in func.__code__.co_consts:
        if const == key or (isinstance(const, tuple) and key in const):
            return True
    return False


def _keyword_only(func, name):
    """Whether `func` takes `name` as a keyword-only argument.

    Keyword-only is what makes the JOIN_SESSION wrapper safe: it sets the value
    in kwargs, so a release that made it positional would raise "multiple
    values" on every join rather than fail here.
    """
    if not callable(func):
        return False
    param = inspect.signature(func).parameters.get(name)
    return param is not None and param.kind is inspect.Parameter.KEYWORD_ONLY


def _bindings():
    """Everything the adaptations touch, with what to say when one has moved."""
    from qobuz_proxy import app as proxy_app
    from qobuz_proxy import cli
    from qobuz_proxy.app import QobuzProxy
    from qobuz_proxy.backends import PlaybackState
    from qobuz_proxy.backends.local.stream import AudioOutputStream
    from qobuz_proxy.connect import WsManager
    from qobuz_proxy.connect.protocol import ProtocolCodec
    from qobuz_proxy.playback.player import QobuzPlayer
    from qobuz_proxy.speaker import Speaker

    return [
        (
            "qobuz_proxy.cli.main",
            callable(getattr(cli, "main", None)),
            "there is nothing left for this launcher to hand over to — the "
            "service would crash-loop under Restart=always",
        ),
        (
            "Speaker.get_status",
            callable(getattr(Speaker, "get_status", None)),
            "the status API Milo polls is gone",
        ),
        (
            'Speaker.get_status still deals in "now_playing"',
            _mentions_key(Speaker.get_status, "now_playing"),
            "the key progress is added to was renamed — the bar would stop moving in silence",
        ),
        (
            "Speaker.get_status reaches the player through _player",
            "_player" in Speaker.get_status.__code__.co_names,
            "the attribute progress is read from was renamed",
        ),
        (
            "QobuzPlayer.current_position_ms",
            hasattr(QobuzPlayer, "current_position_ms"),
            "there is no position left to report",
        ),
        (
            "QobuzPlayer.duration_ms",
            hasattr(QobuzPlayer, "duration_ms"),
            "there is no duration left to report",
        ),
        (
            "QobuzPlayer.state",
            hasattr(QobuzPlayer, "state"),
            "the session's phase can no longer be read",
        ),
        (
            "PlaybackState is exactly the five states Milo maps",
            PLAYER_STATES == set(PlaybackState.__members__),
            "a state was renamed, dropped or added — Milo would read it as loading",
        ),
        (
            "Speaker keeps its WebSocket manager in _ws_manager",
            "_ws_manager" in Speaker.__init__.__code__.co_names,
            "the attribute the app's selection is read from was renamed",
        ),
        (
            "WsManager keeps the cloud's SET_ACTIVE in _renderer_active",
            "_renderer_active" in WsManager.__init__.__code__.co_names,
            "the app picking another output can no longer be seen",
        ),
        (
            "AudioOutputStream.set_volume",
            callable(getattr(AudioOutputStream, "set_volume", None)),
            "the app slider can no longer be held at unity before CamillaDSP",
        ),
        (
            "AudioOutputStream.__init__ sets _volume",
            "_volume" in AudioOutputStream.__init__.__code__.co_names,
            "the gain attribute the stream multiplies by was renamed",
        ),
        (
            "qobuz_proxy.app.register_routes",
            callable(getattr(proxy_app, "register_routes", None)),
            "the web UI's request gate has nothing to attach to — :8689 would "
            "answer a foreign page",
        ),
        (
            "QobuzProxy._start_web_server builds the web UI through register_routes",
            "register_routes" in QobuzProxy._start_web_server.__code__.co_names,
            "the web UI is built another way and the gate would not reach it",
        ),
        (
            "QobuzProxy._on_auth_token starts the speakers only while _speakers is empty",
            inspect.iscoroutinefunction(getattr(QobuzProxy, "_on_auth_token", None))
            and {"_speakers", "_start_speakers"} <= set(QobuzProxy._on_auth_token.__code__.co_names),
            "a login no longer reads the running speakers — serializing logins would "
            "not stop a second one from starting the speaker again",
        ),
        (
            "QobuzProxy._start_web_server hands the web UI its login callback, _on_auth_token",
            "_on_auth_token" in QobuzProxy._start_web_server.__code__.co_names,
            "the web UI reaches the login another way and two callbacks at once "
            "would start the speaker twice again",
        ),
        (
            "ProtocolCodec.encode_join_session takes supports_volume_control by keyword",
            _keyword_only(getattr(ProtocolCodec, "encode_join_session", None),
                          "supports_volume_control"),
            "the app can no longer be told the volume is the device's — it would "
            "offer a slider that does nothing",
        ),
    ]


def check():
    """Report every binding that moved. Exit 1 on the first release that breaks one."""
    moved = [(name, why) for name, ok, why in _bindings() if not ok]
    if moved:
        print("qobuz-proxy no longer offers what Milo adapts:", file=sys.stderr)
        for name, why in moved:
            print(f"  {name}: {why}", file=sys.stderr)
        print(
            "Upstream refactored — re-derive the adaptation in "
            "rootfs/usr/local/bin/milo-qobuz before shipping this version.",
            file=sys.stderr,
        )
        return 1
    print(f"qobuz-proxy adaptations bind cleanly ({len(_bindings())} checks)")
    return 0


def session_fields(player, ws_manager):
    """`player_state` and `renderer_active`, from the speaker's two components.

    Either can be missing on a speaker that has not finished starting, which
    reads as no session: no state, not the app's output.
    """
    return {
        "player_state": player.state.name.lower() if player is not None else None,
        "renderer_active": bool(ws_manager is not None and ws_manager._renderer_active),
    }


def _app_volume_allowed():
    """The one-byte flag the backend writes from the "allow app volume" setting."""
    flag = os.path.join(os.environ.get("QOBUZPROXY_DATA_DIR", "."), VOLUME_FLAG)
    try:
        with open(flag) as handle:
            return handle.read().strip() == "1"
    except OSError:
        return False


def advertised_volume_control(upstream):
    """What JOIN_SESSION says about the app's slider: upstream's answer, and the flag.

    Upstream's own refusal (a fixed-volume DLNA renderer) is kept; the flag can
    only take control away from the app, never grant it back.
    """
    return upstream and _app_volume_allowed()


def with_volume_policy(encode_join_session):
    """`ProtocolCodec.encode_join_session`, advertising the flag's volume policy."""

    def encode_join_session_with_policy(self, *args, **kwargs):
        kwargs["supports_volume_control"] = advertised_volume_control(
            kwargs.get("supports_volume_control", True)
        )
        return encode_join_session(self, *args, **kwargs)

    return encode_join_session_with_policy


def _hostname(url):
    """Bare lowercase host of an `Origin` value, or of a `Host` header given as `//host`."""
    try:
        return urlsplit(url).hostname
    except ValueError:
        return None


def _is_appliance_host(host):
    if not host:
        return False
    if APPLIANCE_NAME.match(host):
        return True
    try:
        return ipaddress.ip_address(host).is_private
    except ValueError:
        return False


def rejection(method, raw_host, origin):
    """Why the backend's gate would refuse this request — empty when it would serve it."""
    if not _is_appliance_host(_hostname(f"//{raw_host}")):
        return f"untrusted Host {raw_host!r}"
    if (method in STATE_CHANGING_METHODS and origin
            and not _is_appliance_host(_hostname(origin))):
        return f"untrusted Origin {origin!r}"
    return ""


def with_request_gate(register_routes):
    """`qobuz_proxy.app.register_routes`, putting the web app behind the gate.

    Appended after upstream's routes: the middleware list is frozen only when
    the runner sets the app up, after this returns.
    """
    from aiohttp import web

    @web.middleware
    async def request_gate(request, handler):
        reason = rejection(request.method, request.headers.get("Host", ""),
                           request.headers.get("Origin"))
        if reason:
            logger.warning("Refused %s %s: %s", request.method, request.path, reason)
            return web.json_response(
                {"status": "error", "message": "Untrusted request origin"}, status=403
            )
        return await handler(request)

    def register_routes_behind_gate(app):
        register_routes(app)
        app.middlewares.append(request_gate)

    return register_routes_behind_gate


def one_login_at_a_time(on_auth_token):
    """`QobuzProxy._on_auth_token`, behind one lock: a second login waits for
    the first's speaker start and then finds it running (adaptation 6)."""
    lock = asyncio.Lock()

    @functools.wraps(on_auth_token)
    async def on_auth_token_serialized(self, *args, **kwargs):
        async with lock:
            return await on_auth_token(self, *args, **kwargs)

    return on_auth_token_serialized


def apply():
    from qobuz_proxy import app as proxy_app
    from qobuz_proxy.backends.local.stream import AudioOutputStream
    from qobuz_proxy.connect.protocol import ProtocolCodec
    from qobuz_proxy.speaker import Speaker

    stream_init = AudioOutputStream.__init__

    def __init__(self, *args, **kwargs):
        stream_init(self, *args, **kwargs)
        # Unity, not upstream's 50 %: the policy below is what may lower it.
        self._volume = 1.0

    def set_volume(self, level):
        self._volume = max(0.0, min(1.0, level / 100.0)) if _app_volume_allowed() else 1.0

    AudioOutputStream.__init__ = __init__
    AudioOutputStream.set_volume = set_volume

    speaker_status = Speaker.get_status

    def get_status(self):
        status = speaker_status(self)
        status.update(session_fields(self._player, self._ws_manager))
        now_playing = status.get("now_playing")
        if now_playing is not None:
            # `current_position_ms` extrapolates from the last backend report, so
            # it stays smooth between Milo's ~1 Hz polls.
            now_playing["position_ms"] = self._player.current_position_ms
            now_playing["duration_ms"] = self._player.duration_ms
        return status

    Speaker.get_status = get_status

    ProtocolCodec.encode_join_session = with_volume_policy(ProtocolCodec.encode_join_session)

    # The module's attribute, not webui.routes': app.py bound the name at import.
    proxy_app.register_routes = with_request_gate(proxy_app.register_routes)

    # Before any instance: the web UI binds self._on_auth_token when it is built.
    proxy_app.QobuzProxy._on_auth_token = one_login_at_a_time(proxy_app.QobuzProxy._on_auth_token)


def main():
    if "--check" in sys.argv[1:]:
        return check()

    failed = check()
    if failed:
        return failed

    apply()
    from qobuz_proxy.cli import main as qobuz_proxy_main

    return qobuz_proxy_main()


if __name__ == "__main__":
    sys.exit(main())
