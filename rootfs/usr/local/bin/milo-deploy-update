#!/bin/bash
# Milo - Secure Update Deployment Wrapper
# Centralizes all privileged operations needed during updates.
# Called via: sudo milo-deploy-update <subcommand> [args] — and, for
# apply-system-manifest alone, by pi-gen/stage-milo as root in its chroot.
set -euo pipefail

REPO_PATH="/home/milo/milo"

error_exit() { echo "ERROR: $1" >&2; exit 1; }

# Install this very script, which a plain `cp` cannot do: bash reads a script
# lazily by byte offset, so overwriting it mid-run makes the shell resume at the
# same offset in different bytes and die on a syntax error in whatever token it
# lands in — after the deploy has already happened, so the caller sees a failure
# for work that was done.
#
# Writing beside it and renaming is the fix, not skipping it: rename(2) swaps
# the directory entry while this process keeps reading the inode it opened, so
# the running shell is untouched and the next run is the new script. Skipping
# left the unit on whatever version was installed the day it was set up, and
# every later fix to this file stopped at its door, silently.
#
# This is not the `install_binary` guard below and does not weaken it: that one
# refuses an arbitrary /tmp source, which is a lower trust level than
# $REPO_PATH — a tree the repo already deploys to /usr/local/bin as root.
#
# The `.new` file must sit in the destination directory, not /tmp: mv across
# filesystems degrades to copy-then-unlink, which is exactly the in-place
# overwrite this avoids.
install_self() {
    local rel_path="$1"
    install_atomic "$REPO_PATH/rootfs/$rel_path" "/$rel_path" +x
    echo "  Installed /$rel_path (renamed into place)"
}

# Every other file goes in by the same rename: written beside its destination,
# then swapped in, so a power cut leaves the old file or the new one, never a
# truncated unit or helper — a rollback (milo-update-guard) runs this script
# from the backend's next start, where a unit cut in half is a backend that
# never starts. `.new` is a name the directories written here do not read as
# config: systemd wants a unit suffix, udev `.rules`, sysctl.d and conf.d
# `.conf`. nginx's sites-enabled/ is the exception, as it reads every file
# there, and install_nginx_conf stages outside it. Same shape as the
# satellite's milo-client-deploy-update.
install_atomic() {
    # $1 source, $2 destination, then optionally $3 a chmod mode, $4 a chown owner
    cp "$1" "$2.new"
    [ -z "${3:-}" ] || chmod "$3" "$2.new"
    [ -z "${4:-}" ] || chown "$4" "$2.new"
    mv -f "$2.new" "$2"
}

# A sudoers policy is validated before it can take effect, and swapped in by
# rename. sudo >= 1.9.3 does not refuse to run over a policy file with a syntax
# error — it skips that file — so a malformed one is silently ignored whole, and
# what that costs depends on the file and the unit. milo-backend's first rule
# grants nothing: it takes back the blanket NOPASSWD: ALL a base image may give
# its first user, `milo` here (/etc/sudoers.d/010_pi-nopasswd). Where that file
# exists, skipping milo-backend puts the blanket back in force and nothing
# fails — every command runs passwordless again. Where it does not, every
# grant the policy holds is gone, and the failure surfaces later as a helper
# that no longer runs; milo-ir-remote, which holds no such rule, always costs
# its one grant. The staging name ends in `.new`: sudo ignores any file in
# sudoers.d whose name contains a dot, so the half-installed copy is never read
# as a policy.
install_sudoers() {
    local rel_path="$1"
    local target="/$rel_path"

    cp "$REPO_PATH/rootfs/$rel_path" "$target.new"
    chmod 0440 "$target.new"
    visudo -c -f "$target.new" >/dev/null || {
        rm -f "$target.new"
        error_exit "sudoers syntax error in $rel_path -- not installed"
    }
    mv -f "$target.new" "$target"
    echo "  Installed $target (validated)"
}

# sshd refuses to start on a config it cannot parse, so a bad drop-in would take
# SSH down at the next boot rather than fail here. Each one is checked against
# the whole config (`sshd -t` reads sshd_config.d/*.conf) and the previous copy
# put back if it breaks it. The running sshd parsed its config at start: it is
# told to read it again, or a drop-in would wait for the next reboot.
install_sshd_dropin() {
    local rel_path="$1"
    local target="/$rel_path"

    mkdir -p "$(dirname "$target")"
    [ -f "$target" ] && cp -p "$target" "$target.previous"
    install_atomic "$REPO_PATH/rootfs/$rel_path" "$target" 0644
    if command -v sshd >/dev/null && ! sshd -t; then
        if [ -f "$target.previous" ]; then mv -f "$target.previous" "$target"; else rm -f "$target"; fi
        error_exit "sshd rejects $rel_path -- not installed"
    fi
    rm -f "$target.previous"
    echo "  Installed $target (validated)"
}

# nginx refuses to start on a site it cannot parse, and a unit whose nginx is
# down has no interface at all — while the backend, whose start is all the
# update guard judges, starts fine. So the site is checked against the whole
# config (`nginx -t`) and the previous copy put back if it breaks it, which
# fails the update instead. The previous copy and the new one wait outside
# sites-enabled/, on the same filesystem: nginx reads every file there, and a
# second `upstream milo_backend` beside the site — a copy cut by a power loss
# included — is a config it refuses at its next start, which
# `try-reload-or-restart` never retries.
install_nginx_conf() {
    local rel_path="$1"
    local target="/$rel_path" name
    name=$(basename "$target")

    mkdir -p "$(dirname "$target")"
    [ -f "$target" ] && cp -p "$target" "/etc/nginx/$name.previous"
    cp "$REPO_PATH/rootfs/$rel_path" "/etc/nginx/$name.new"
    chmod 0644 "/etc/nginx/$name.new"
    mv -f "/etc/nginx/$name.new" "$target"
    if command -v nginx >/dev/null && ! nginx -t -q; then
        if [ -f "/etc/nginx/$name.previous" ]; then mv -f "/etc/nginx/$name.previous" "$target"; else rm -f "$target"; fi
        error_exit "nginx rejects $rel_path -- not installed"
    fi
    rm -f "/etc/nginx/$name.previous"
    echo "  Installed $target (validated)"
}

# --- The system manifest ---
#
# What a unit holds besides its files — packages, the managed lines of config.txt
# and cmdline.txt, unit states — is declared once, in the checkout's
# system-manifest.env, which says what each declaration means. The image applies
# it (apply-system-manifest, from pi-gen/stage-milo), and so does every update
# (sync-system-files), so an updated unit holds what a flashed card holds.
# Sourced as root, like every file this script installs from the checkout as
# root: the checkout is the backend's to write, and the backend is root by
# construction.
#
# Additive both ways: nothing is removed, disabled, unmasked or taken out of a
# boot file. That is what keeps the guard's sync back to the previous release
# offline and quick at boot: what that release declares is already there.

MANIFEST="$REPO_PATH/system-manifest.env"
# The arrays a manifest declares cross releases, as the update journal's names
# do: the installed script reads whatever tree it is handed — the arriving
# release's on an update, and on the guard's sync back the previous release's,
# with the newer script. So these six are frozen, never renamed or removed
# (test_image_update_convergence.py). An array added later goes in
# MANIFEST_ARRAYS_ADDED and reads as empty in a tree older than it; the release
# that adds one has it applied from the update after it, since an update is run
# by the departing release's script.
MANIFEST_ARRAYS=(SYSTEM_APT_PACKAGES SYSTEM_CMDLINE SYSTEM_CMDLINE_SEED SYSTEM_CONFIG_TXT
                 SYSTEM_UNITS_ENABLED SYSTEM_UNITS_MASKED)
MANIFEST_ARRAYS_ADDED=()
# How long apt-get waits for another dpkg to let go, and so does the dpkg run
# that finishes an interrupted one: under the guard's 120 s for a whole sync.
DPKG_LOCK_TIMEOUT_S=60
CONFIG_BLOCK_BEGIN="# BEGIN MILO SYSTEM"
CONFIG_BLOCK_END="# END MILO SYSTEM"
# milo-set-wifi-country's: the two writers of cmdline.txt take turns on it.
CMDLINE_LOCK=/run/lock/milo-set-wifi-country.lock

read_system_manifest() {
    [ -f "$MANIFEST" ] || error_exit "$MANIFEST is missing -- no system state applied"
    # shellcheck source=/dev/null
    source "$MANIFEST"
    local name
    for name in "${MANIFEST_ARRAYS[@]}"; do
        [[ "$(declare -p "$name" 2>/dev/null)" == "declare -a"* ]] \
            || error_exit "$MANIFEST declares no $name array"
    done
    for name in "${MANIFEST_ARRAYS_ADDED[@]}"; do
        declare -p "$name" >/dev/null 2>&1 || declare -ga "$name=()"
        [[ "$(declare -p "$name")" == "declare -a"* ]] \
            || error_exit "$MANIFEST declares $name, but not as an array"
    done
}

# The boot partition, mounted here since Bookworm: no Milō image has another
# layout, and what Raspberry Pi OS leaves at /boot/config.txt is a stub saying
# the file moved, which a write would reach in silence.
boot_file() {
    echo "/boot/firmware/$1"
}

# /boot/firmware is vfat, with no journal: a file truncated in place and cut by
# a power loss is a unit that does not boot. A sibling is written, flushed and
# renamed over it, then the partition and the file are flushed (syncfs sends no
# cache flush on vfat, the file's fsync does) — milo-set-wifi-country's steps.
write_boot_file() {
    local target="$1" content="$2"
    local tmp="$target.milo-new"
    printf '%s\n' "$content" > "$tmp"
    sync "$tmp"
    mv -f "$tmp" "$target"
    sync -f "$target"
    sync "$target"
}

apply_config_txt() {
    local file current block new begins ends
    file=$(boot_file config.txt)
    [ -f "$file" ] || error_exit "$file is missing -- boot lines not applied"
    current=$(cat "$file")
    block=$(printf '%s\n' "$CONFIG_BLOCK_BEGIN" "${SYSTEM_CONFIG_TXT[@]}" "$CONFIG_BLOCK_END")
    begins=$(grep -cxF -- "$CONFIG_BLOCK_BEGIN" "$file" || true)
    ends=$(grep -cxF -- "$CONFIG_BLOCK_END" "$file" || true)

    if [ "$begins" = 0 ] && [ "$ends" = 0 ]; then
        new="$current"$'\n\n'"$block"
    elif [ "$begins" = 1 ] && [ "$ends" = 1 ]; then
        # Replaced where it stands. A block that never ends would swallow the
        # rest of the file, the hardware's blocks included: refused instead.
        new=$(BLOCK="$block" awk -v b="$CONFIG_BLOCK_BEGIN" -v e="$CONFIG_BLOCK_END" '
            $0 == b { print ENVIRON["BLOCK"]; skip = 1; next }
            skip { if ($0 == e) skip = 0; next }
            { print }
            END { if (skip) exit 3 }
        ' "$file") || error_exit "$file: '$CONFIG_BLOCK_BEGIN' has no end after it -- left untouched"
    else
        error_exit "$file holds $begins '$CONFIG_BLOCK_BEGIN' and $ends '$CONFIG_BLOCK_END' lines -- left untouched"
    fi

    if [ "$new" = "$current" ]; then
        echo "  config.txt: managed lines already in place"
        return 0
    fi
    write_boot_file "$file" "$new"
    echo "  config.txt: managed lines written"
}

apply_cmdline() {
    local file current token new
    local -a words=() kept=()
    local -A managed=() present=()
    file=$(boot_file cmdline.txt)
    [ -f "$file" ] || error_exit "$file is missing -- boot lines not applied"

    mkdir -p "$(dirname "$CMDLINE_LOCK")"
    exec 9>"$CMDLINE_LOCK"
    flock -w 10 9 || error_exit "milo-set-wifi-country still holds $CMDLINE_LOCK -- cmdline.txt not applied"

    current=$(cat "$file")
    # Without root= the next boot finds no root filesystem: never write that back.
    [[ "$current" =~ (^|[[:space:]])root= ]] \
        || error_exit "$file is empty or carries no root= -- left untouched"

    for token in "${SYSTEM_CMDLINE[@]}"; do managed["${token%%=*}"]=1; done
    read -r -d '' -a words <<< "$current" || true
    for token in "${words[@]}"; do
        present["${token%%=*}"]=1
        [ -n "${managed[${token%%=*}]:-}" ] || kept+=("$token")
    done
    for token in "${SYSTEM_CMDLINE_SEED[@]}"; do
        [ -n "${present[${token%%=*}]:-}" ] || kept+=("$token")
    done
    new="${kept[*]} ${SYSTEM_CMDLINE[*]}"

    if [ "$new" = "$current" ]; then
        echo "  cmdline.txt: managed tokens already in place"
    else
        write_boot_file "$file" "$new"
        echo "  cmdline.txt: managed tokens written"
    fi
    exec 9>&-
}

# One call per verb; on a refusal the error line carries systemctl's own, which
# names the unit (missing, masked, a bad [Install]), since that line is the one
# the guard and the update screen show.
apply_unit_states() {
    local out
    if [ ${#SYSTEM_UNITS_ENABLED[@]} -gt 0 ]; then
        out=$(systemctl enable -q "${SYSTEM_UNITS_ENABLED[@]}" 2>&1) \
            || error_exit "systemctl refused to enable the manifest's units: $(failure_line "$out")"
    fi
    if [ ${#SYSTEM_UNITS_MASKED[@]} -gt 0 ]; then
        out=$(systemctl mask -q "${SYSTEM_UNITS_MASKED[@]}" 2>&1) \
            || error_exit "systemctl refused to mask the manifest's units: $(failure_line "$out")"
    fi
    echo "  units: ${#SYSTEM_UNITS_ENABLED[@]} enabled, ${#SYSTEM_UNITS_MASKED[@]} masked"
}

# The line apt-get, dpkg or systemctl ends a failure on, for an error a person
# can read.
failure_line() {
    local line
    line=$(grep -E '^(E|Err|dpkg: error)' <<< "$1" | tail -n 1 || true)
    line="${line:-${1##*$'\n'}}"
    echo "${line:-no reason given}"
}

is_installed() {
    [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ]
}

# dpkg takes its lock without waiting where apt-get waits for it. An install cut
# by a power loss leaves dpkg "interrupted", and apt-get then refuses every
# install until this runs: it is retried while another dpkg holds the lock, for
# as long as apt-get would wait. A no-op on a healthy system. Not fatal: what it
# cannot finish, apt-get reports below, when there is something to install.
finish_interrupted_dpkg() {
    local waited=0 out
    # In C: its words are matched below.
    until out=$(LC_ALL=C dpkg --configure -a --force-confdef --force-confold 2>&1); do
        # dpkg's own words for a held lock, the frontend's or the database's —
        # dpkg 1.22: "dpkg: error: dpkg frontend lock was locked by
        # /usr/bin/python3.13 process with pid 812" ("by another process" when
        # it cannot name it). Anything else is a failure to report, not a wait.
        if grep -q -E '^dpkg: error: .* was locked by ' <<< "$out" && [ "$waited" -lt "$DPKG_LOCK_TIMEOUT_S" ]; then
            sleep 2
            waited=$((waited + 2))
            continue
        fi
        echo "  WARNING: dpkg --configure -a failed: $(failure_line "$out")"
        return 0
    done
    [ -z "$out" ] || printf '%s\n' "$out"
}

# Only the packages missing are installed, so a unit that has them all — the
# guard's sync back to a release whose packages were already there, a unit
# offline — reaches no network. One apt transaction, --no-remove: nothing an
# install would remove to satisfy a dependency is ever taken away.
install_system_packages() {
    local pkg out unreached
    local -a missing=()
    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true
    export APT_LISTCHANGES_FRONTEND=none

    finish_interrupted_dpkg
    for pkg in "${SYSTEM_APT_PACKAGES[@]}"; do
        is_installed "$pkg" || missing+=("$pkg")
    done
    if [ ${#missing[@]} -eq 0 ]; then
        echo "  packages: all ${#SYSTEM_APT_PACKAGES[@]} installed"
        return 0
    fi

    echo "Installing ${missing[*]}..."
    # The image wipes the package lists, so there is nothing to install from
    # until they are read again. No DPkg::Lock::Timeout: it does not cover the
    # lists' lock, which the backend waits for before it calls this.
    out=$(apt-get update 2>&1) \
        || error_exit "apt-get update failed, so ${missing[*]} could not be installed: $(failure_line "$out")"
    # A source apt-get update cannot reach is only a warning to it, and it exits
    # 0 (measured, apt 3.0): the other sources may still hold the package, so
    # the install is tried. When it fails, that source is the likely cause of
    # the "Unable to locate package" apt then reports, so the error names it —
    # without it, the line reads as a package that does not exist.
    unreached=$(grep -m 1 -E '^W: Failed to fetch ' <<< "$out" || true)
    unreached="${unreached#W: }"
    [ -z "$unreached" ] || echo "  WARNING: apt-get update: $unreached"
    out=$(apt-get install -y --no-install-recommends --no-remove \
            -o DPkg::Lock::Timeout="$DPKG_LOCK_TIMEOUT_S" \
            -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
            "${missing[@]}" 2>&1) || {
        printf '%s\n' "$out"
        error_exit "could not install ${missing[*]}: $(failure_line "$out")${unreached:+ -- apt-get update could not reach a source: $unreached}"
    }
    printf '%s\n' "$out"
    for pkg in "${missing[@]}"; do
        is_installed "$pkg" || error_exit "$pkg is not installed after apt-get"
    done
    echo "  packages: installed ${missing[*]}"
}

# --- Input validation helpers ---

validate_absolute_path() {
    [[ "$1" == /* ]] || error_exit "Path must be absolute: $1"
}

validate_temp_path() {
    case "$1" in
        /tmp/*|/var/tmp/*) ;;
        *) error_exit "Path must be in /tmp or /var/tmp: $1" ;;
    esac
}

validate_no_traversal() {
    [[ "$1" == *..* ]] && error_exit "Path traversal not allowed: $1"
    return 0
}

validate_not_symlink() {
    [ -L "$1" ] && error_exit "Symlinks not allowed: $1"
    return 0
}

# --- Downloaded files: checked on a copy only root can write ---
#
# The backend checks a download against dependencies.env as it arrives, which
# refuses a bad file before anything stops. That is not where the trust
# changes: the file then sits in a milo-owned directory, which any process
# running as milo can rewrite between that check and the install. So the file
# is copied into a directory only root can write, and the copy is checked —
# and the copy, never the path the caller named, is what dpkg or the install
# reads. The digest is the caller's to name, from the manifest; "-" says the
# manifest declares none (a version past it, the operator's trial of what
# upstream published), and is said in the output, never silent.

STAGE=""
cleanup_stage() { [ -z "$STAGE" ] || rm -rf "$STAGE"; }
trap cleanup_stage EXIT

# Sets STAGED to the checked copy of $1, kept under its own name.
stage_checked() {
    local src="$1" expected="$2" name actual
    [ "$expected" = "-" ] || [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
        || error_exit "Not a sha256 digest: $expected"
    name=$(basename "$src")
    STAGE=$(mktemp -d /tmp/milo-checked.XXXXXX)
    STAGED="$STAGE/$name"
    cp -- "$src" "$STAGED"
    if [ "$expected" = "-" ]; then
        echo "WARNING: $name has no declared digest; installed as downloaded" >&2
        return 0
    fi
    actual=$(sha256sum "$STAGED") || error_exit "Could not hash $name"
    actual="${actual%% *}"
    [ "$actual" = "$expected" ] \
        || error_exit "$name: checksum mismatch, declared $expected, got $actual -- not installed"
    echo "  $name: sha256 checked"
}

# --- Subcommands ---

cmd_sync_system_files() {
    # Sync system/*.service and rootfs/** from the repo to their system
    # destinations, then the system manifest: packages, boot lines, unit states.
    # Hardcoded repo path — no arguments needed. Run by the updater after its
    # checkout, before the reboot into the release, and by milo-update-guard
    # after a checkout back: it installs the tree's set over what is there and
    # removes nothing.
    local synced_udev=false
    local synced_nm_conf=false
    local synced_sshd=false
    local synced_nginx=false
    local synced_nftables=false
    local sysctl_files=()

    # 1. Deploy rootfs files (preserving directory structure). Before the units:
    # a unit names its helpers (ExecStartPre= of milo-backend.service is
    # milo-update-guard), and a unit reloaded ahead of a helper it names fails
    # to start in the window between.
    echo "Deploying rootfs files..."
    cd "$REPO_PATH/rootfs"

    # Process substitution avoids subshell so synced_udev is preserved
    while read -r rel_path; do
        rel_path="${rel_path#./}"

        # Every rootfs file is installed; these four are the ones a plain copy
        # cannot install — see install_self, install_sudoers, install_sshd_dropin
        # and install_nginx_conf.
        case "$rel_path" in
            usr/local/bin/milo-deploy-update) install_self "$rel_path"; continue ;;
            etc/sudoers.d/*) install_sudoers "$rel_path"; continue ;;
            etc/ssh/sshd_config.d/*) install_sshd_dropin "$rel_path"; synced_sshd=true; continue ;;
            etc/nginx/*) install_nginx_conf "$rel_path"; synced_nginx=true; continue ;;
        esac

        target="/$rel_path"
        mkdir -p "$(dirname "$target")"

        # The IPv6 firewall, loaded below when its ruleset, its unit's drop-in
        # or the script that fills its set moved — compared before the copy,
        # which installs every file; a ruleset nft refuses is never installed,
        # as a sudoers policy visudo refuses is not.
        case "$rel_path" in
            etc/nftables.conf)
                if ! cmp -s "$REPO_PATH/rootfs/$rel_path" "$target"; then
                    nft -c -f "$REPO_PATH/rootfs/$rel_path" || error_exit "nft rejects $rel_path -- not installed"
                    synced_nftables=true
                fi ;;
            etc/systemd/system/nftables.service.d/*|etc/NetworkManager/dispatcher.d/50-milo-ipv6-link-prefixes)
                cmp -s "$REPO_PATH/rootfs/$rel_path" "$target" || synced_nftables=true ;;
        esac

        # Executable for scripts and dispatcher hooks, ownership for the files
        # the milo user owns on the image — set on the copy, so the file is
        # final the moment it is swapped in.
        mode=""
        owner=""
        case "$target" in
            /usr/local/bin/*|*/dispatcher.d/*|*.sh) mode=+x ;;
        esac
        case "$target" in
            /home/milo/*|/var/lib/milo/*) owner=milo:milo ;;
        esac
        install_atomic "$REPO_PATH/rootfs/$rel_path" "$target" "$mode" "$owner"
        echo "  Installed $target"

        # Track what needs its daemon or the kernel told
        case "$rel_path" in
            etc/udev/*) synced_udev=true ;;
            etc/sysctl.d/*) sysctl_files+=("$target") ;;
            etc/NetworkManager/conf.d/*) synced_nm_conf=true ;;
        esac
    done < <(find . -type f)

    # 2. Deploy systemd service files
    echo "Deploying systemd service files..."
    for service_file in "$REPO_PATH"/system/*.service; do
        [ -f "$service_file" ] || continue
        install_atomic "$service_file" "/etc/systemd/system/$(basename "$service_file")"
        echo "  Installed $(basename "$service_file")"
    done

    # Deploy avahi-daemon override if present
    if [ -f "$REPO_PATH/system/avahi-daemon-override.conf" ]; then
        mkdir -p /etc/systemd/system/avahi-daemon.service.d/
        install_atomic "$REPO_PATH/system/avahi-daemon-override.conf" \
            /etc/systemd/system/avahi-daemon.service.d/milo-override.conf
        echo "  Installed avahi-daemon override"
    fi

    systemctl daemon-reload
    echo "  systemctl daemon-reload done"

    # 3. The system manifest, read and applied after the files: on the guard's
    # sync back, a tree with no manifest (a release older than it) or a package
    # that cannot be installed must not leave the newer release's files in
    # place with the older release's code. The packages before the unit
    # states, which may name a unit only a package brings.
    echo "Applying the system manifest..."
    read_system_manifest
    install_system_packages
    apply_config_txt
    apply_cmdline
    apply_unit_states

    # 4. Reload udev rules if any were synced
    if [ "$synced_udev" = true ]; then
        udevadm control --reload-rules
        udevadm trigger
        echo "  udev rules reloaded"
    fi

    # Our own files only, every time: a copy changes nothing until applied, and
    # `sysctl --system` would also re-read every distro file, any of which can
    # fail this update under set -e. `-e` because a key the kernel lacks is not
    # a failure: with IPv6 off at boot (`ipv6.disable=1`) there is no
    # /proc/sys/net/ipv6, `-p` exits 1 on 90-milo-linkdown.conf's ipv6 lines,
    # and the Milō update — or the guard's sync back — fails with it.
    for sysctl_file in "${sysctl_files[@]}"; do
        sysctl -e -q -p "$sysctl_file"
        echo "  Applied $sysctl_file"
    done

    # NetworkManager reads conf.d at start; reloading it applies connection
    # defaults to the next activation without touching a live link.
    if [ "$synced_nm_conf" = true ]; then
        nmcli general reload conf
        echo "  NetworkManager configuration reloaded"
    fi

    # Reload only a running sshd: SSH ships off, and this must not start it.
    if [ "$synced_sshd" = true ]; then
        systemctl try-reload-or-restart ssh.service
        echo "  sshd configuration reloaded"
    fi

    # nginx parsed its configuration at start: reloaded, it serves the site
    # just installed — the guard's sync back included, which no reboot
    # follows. Only a running nginx, as for sshd.
    if [ "$synced_nginx" = true ]; then
        systemctl try-reload-or-restart nginx.service
        echo "  nginx configuration reloaded"
    fi

    # nftables.service loaded the ruleset at its start; a reload loads the one
    # just installed (its drop-in then fills link_prefixes again) — the guard's
    # sync back included, which no reboot follows. Only on a real change, and
    # only a running firewall: one stopped by hand stays stopped.
    if [ "$synced_nftables" = true ]; then
        systemctl try-reload-or-restart nftables.service
        echo "  nftables ruleset reloaded (it changed)"
    fi

    # The updater moves its journal forward, and the guard closes its rollback,
    # on this exit: what was renamed into place must be on the card by then.
    sync

    echo "System files sync complete"
}

# The image's half of the manifest, run by pi-gen/stage-milo in its chroot once
# the units are in place: the same boot lines and unit states an update applies,
# by the same code. The image installs the packages itself, with their
# recommends, and its own reloads are a first boot.
cmd_apply_system_manifest() {
    [ $# -eq 0 ] || error_exit "Usage: apply-system-manifest"
    read_system_manifest
    apply_config_txt
    apply_cmdline
    apply_unit_states
}

cmd_install_binary() {
    [ $# -ne 2 ] && error_exit "Usage: install-binary <src> <dest>"
    local src="$1" dest="$2"

    validate_absolute_path "$src"
    validate_absolute_path "$dest"
    validate_no_traversal "$src"
    validate_no_traversal "$dest"
    validate_temp_path "$src"

    # Destination must be in /usr/local/bin/
    case "$dest" in
        /usr/local/bin/*) ;;
        *) error_exit "Destination must be in /usr/local/bin/: $dest" ;;
    esac

    [ ! -f "$src" ] && error_exit "Source file does not exist: $src"
    validate_not_symlink "$src"

    # Prevent overwriting this script itself
    [[ "$(basename "$dest")" == "milo-deploy-update" ]] && \
        error_exit "Cannot overwrite the deploy script itself"

    # Renamed into place, as install_self does: the unit may still be running
    # the old image, and writing onto it in place fails with "Text file busy".
    cp "$src" "$dest.new"
    chmod 755 "$dest.new"
    mv -f "$dest.new" "$dest"
    sync
    echo "OK: Installed binary $dest"
}

# A program shipped as one binary inside a release tarball (go-librespot,
# CamillaDSP, Navidrome): the tarball is checked, and the binary unpacked from
# the checked copy, as root, into the same root-only directory — one named
# member, never the whole archive, without the owners and modes it carries.
cmd_install_release_binary() {
    [ $# -ne 4 ] && error_exit "Usage: install-release-binary <archive.tar.gz> <member> <dest> <sha256|->"
    local archive="$1" member="$2" dest="$3" sha256="$4"

    validate_absolute_path "$archive"
    validate_no_traversal "$archive"
    validate_temp_path "$archive"
    [[ "$archive" == *.tar.gz ]] || error_exit "Not a .tar.gz archive: $archive"
    [ ! -f "$archive" ] && error_exit "Archive does not exist: $archive"
    validate_not_symlink "$archive"
    [[ "$member" =~ ^[A-Za-z0-9._-]+$ ]] || error_exit "Not a plain member name: $member"

    stage_checked "$archive" "$sha256"
    tar -xzf "$STAGED" -C "$STAGE" --no-same-owner --no-same-permissions "$member" \
        || error_exit "No $member in $(basename "$archive")"
    [ -f "$STAGE/$member" ] && [ ! -L "$STAGE/$member" ] \
        || error_exit "$member in $(basename "$archive") is not a regular file"
    cmd_install_binary "$STAGE/$member" "$dest"
}

cmd_install_deb() {
    [ $# -ne 2 ] && error_exit "Usage: install-deb <path> <sha256|->"
    local deb_path="$1" sha256="$2"

    validate_absolute_path "$deb_path"
    validate_no_traversal "$deb_path"
    validate_temp_path "$deb_path"

    # Must be a .deb file
    [[ "$deb_path" == *.deb ]] || error_exit "Not a .deb file: $deb_path"
    [ ! -f "$deb_path" ] && error_exit "File does not exist: $deb_path"
    validate_not_symlink "$deb_path"

    # From here on the checked copy: a .deb runs its maintainer scripts as root.
    stage_checked "$deb_path" "$sha256"
    deb_path="$STAGED"

    local pkg ver
    pkg=$(dpkg-deb -f "$deb_path" Package) || error_exit "Not a readable .deb: $deb_path"
    ver=$(dpkg-deb -f "$deb_path" Version) || error_exit "Not a readable .deb: $deb_path"
    [ -n "$pkg" ] && [ -n "$ver" ] || error_exit "No Package/Version in $deb_path"

    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true
    export APT_LISTCHANGES_FRONTEND=none

    # The same finish as sync-system-files', waiting as long as apt-get does for
    # another dpkg (unattended-upgrades can take the lock between the backend's
    # wait for apt and this line). What it could not finish, apt-get reports
    # below in words.
    echo "Finishing any interrupted dpkg run..."
    finish_interrupted_dpkg

    # The lists' lock is never waited for: DPkg::Lock::Timeout covers dpkg's
    # locks alone, and `apt-get update` fails at once on the lists' (measured,
    # apt 3.0.4), so the backend waits for it before it calls this.
    echo "Updating APT package list..."
    apt-get update -qq

    # One apt transaction, never `dpkg -i` then `apt-get -f install -y`: the
    # repair step satisfies a Depends it cannot meet by removing the package
    # just unpacked, and exits 0. --no-remove refuses any removal instead, and
    # --allow-downgrades because the validated pin may sit below what runs.
    echo "Installing $(basename "$deb_path")..."
    apt-get install -y -qq --no-remove --allow-downgrades --no-install-recommends \
        -o DPkg::Lock::Timeout="$DPKG_LOCK_TIMEOUT_S" \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        "$deb_path"

    local state
    state=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "$pkg" 2>/dev/null) || state="not-installed"
    [ "$state" = "installed $ver" ] \
        || error_exit "$pkg reads '$state' after apt, expected $ver"

    echo "OK: $pkg $ver installed"
}

cmd_write_config() {
    [ $# -ne 2 ] && error_exit "Usage: write-config <src> <dest>"
    local src="$1" dest="$2"

    validate_absolute_path "$src"
    validate_absolute_path "$dest"
    validate_no_traversal "$src"
    validate_no_traversal "$dest"

    # Source must be in /tmp or /var/tmp
    validate_temp_path "$src"

    # Destination must be in /etc/
    case "$dest" in
        /etc/*) ;;
        *) error_exit "Destination must be in /etc/: $dest" ;;
    esac

    [ ! -f "$src" ] && error_exit "Source file does not exist: $src"
    validate_not_symlink "$src"

    cp "$src" "$dest"
    rm -f "$src"
    echo "OK: Config written to $dest"
}

# The Tidal Connect runtime tree, which the image does not carry: TidalSource
# asks for it the first time Tidal is selected or enabled in the Dock. Built by
# the checkout's own provisioning/tidal_connect_runtime.py, which checks every
# byte it unpacks against a digest it names and verifies the result, into a
# staging directory renamed into place only once that verification passed — so
# the launcher (milo-tidal-connect) finds a whole tree or none, and a build cut
# short, a backend restart included, leaves nothing it could start on.
TIDAL_ROOT="/opt/milo/tidal-connect"

cmd_install_tidal_runtime() {
    [ $# -eq 0 ] || error_exit "Usage: install-tidal-runtime"
    local staging="$TIDAL_ROOT.new" previous="$TIDAL_ROOT.old"

    mkdir -p "$(dirname "$TIDAL_ROOT")"
    rm -rf "$staging" "$previous"
    # -I: run as root, the builder imports nothing from its directory or
    # the environment.
    python3 -I "$REPO_PATH/provisioning/tidal_connect_runtime.py" --root "$staging" \
        || { rm -rf "$staging"; error_exit "the Tidal Connect runtime could not be built"; }
    # Read-only for the service user: nothing under here is written at run time
    # (the controller socket lives in /run/milo).
    chown -R root:root "$staging"
    if [ -e "$TIDAL_ROOT" ]; then
        mv "$TIDAL_ROOT" "$previous"
    fi
    mv "$staging" "$TIDAL_ROOT"
    rm -rf "$previous"
    sync
    echo "OK: Tidal Connect runtime installed in $TIDAL_ROOT"
}

cmd_reboot() {
    echo "Rebooting system..."
    /sbin/reboot
}

# --- Main dispatcher ---

[ $# -lt 1 ] && error_exit "Usage: $0 <subcommand> [args...]"

subcommand="$1"
shift

case "$subcommand" in
    check)             echo "OK" ;;
    sync-system-files) cmd_sync_system_files "$@" ;;
    apply-system-manifest) cmd_apply_system_manifest "$@" ;;
    install-binary)    cmd_install_binary "$@" ;;
    install-release-binary) cmd_install_release_binary "$@" ;;
    install-deb)       cmd_install_deb "$@" ;;
    write-config)      cmd_write_config "$@" ;;
    install-tidal-runtime) cmd_install_tidal_runtime "$@" ;;
    reboot)            cmd_reboot "$@" ;;
    *) error_exit "Unknown subcommand: $subcommand" ;;
esac
