#!/bin/bash
# milo-umount — privileged unmount of a Milō USB mountpoint under /media/milo.
#
# Usage: milo-umount <mountpoint>
#   <mountpoint>: an absolute path directly under /media/milo, exactly as returned
#                 by milo-mount (the backend hands back what it captured).
#
# Counterpart to milo-mount. Validates the target sits directly beneath
# /media/milo — a single safe-named component, no traversal — then unmounts it if
# the mount table lists it and removes the now-empty directory. Exits non-zero
# while the table still lists the target, so "unmounted" is never said of a
# mount that stayed.
# Falls back to a lazy unmount when the mount is busy (Navidrome still holding a
# file handle, the device yanked, a NAS gone). Must run as root (milo-backend
# sudoers).
set -euo pipefail

MOUNT_ROOT="/media/milo"

log() { echo "milo-umount: $*" >&2; }
die() { log "ERROR: $*"; exit 1; }

# Whether $1 is a mountpoint, read from the kernel's mount table — never from a
# stat of the target: on a dead CIFS share the stat fails (EHOSTDOWN, ~10 s),
# which mountpoint(1) reads as "not mounted". The table escapes a mountpoint's
# backslash, space, tab and newline as octal, so the target is escaped the same
# way (backslash first) and matched exactly; awk takes it from the environment
# because -v would undo the escapes. $2 (another table) is for the tests only.
in_mount_table() {
    local t="$1"
    t="${t//\\/\\134}"
    t="${t// /\\040}"
    t="${t//$'\t'/\\011}"
    t="${t//$'\n'/\\012}"
    T="$t" awk '$5 == ENVIRON["T"] { found = 1 } END { exit !found }' \
        "${2:-/proc/self/mountinfo}"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ $# -eq 1 ] || die "usage: milo-umount <mountpoint>"

TARGET="$(readlink -f -- "$1")" || die "cannot resolve $1"

# Confine to a single child of the mount root — reject anything else outright.
case "$TARGET" in
    "$MOUNT_ROOT"/*) : ;;
    *) die "$TARGET is not under $MOUNT_ROOT" ;;
esac
NAME="${TARGET#"$MOUNT_ROOT"/}"
case "$NAME" in
    */*|.|..|"") die "invalid mountpoint name: $NAME" ;;
    *) : ;;
esac

if in_mount_table "$TARGET"; then
    # -c: TARGET is already canonical, and canonicalizing it again is a stat.
    # -k: CIFS waits killably on a dead server, which SIGTERM does not wake.
    timeout -k 5 10 umount -c "$TARGET" 2>/dev/null || umount -l -c "$TARGET" \
        || die "failed to unmount $TARGET"
    if in_mount_table "$TARGET"; then
        die "$TARGET is still mounted after unmounting"
    fi
    log "unmounted $TARGET"
else
    log "$TARGET is not mounted (already gone)"
fi

# Drop the mountpoint directory — and it has to actually go.
#
# Navidrome distinguishes "directory absent" (it skips that library and leaves
# its tracks alone) from "directory present but empty" (it walks it, finds
# nothing, and marks every track under it missing on the next scan).
# provisioning/navidrome.sh leans on exactly that asymmetry to make the scheduled
# scan safe over a storage space that is away, so a leftover empty directory is
# NOT harmless: it is what turns an unplug into a library-wide marking, and a
# marked track is gone from the UI until something walks the files again.
#
# The retry is here because rmdir fails while a lazy unmount is still settling —
# i.e. when something still holds a handle, which is precisely the case when
# Navidrome was scanning this mount, which is when the damage would be worst.
# By here the table no longer lists the target, so these stats reach the local
# directory, never the share.
for _ in $(seq 10); do
    rmdir "$TARGET" 2>/dev/null && break
    [ -d "$TARGET" ] || break
    sleep 0.5
done
if [ -d "$TARGET" ]; then
    log "ERROR: $TARGET still present after unmounting — Navidrome will read it" \
        "as an empty library and mark its tracks missing"
    exit 2
fi
