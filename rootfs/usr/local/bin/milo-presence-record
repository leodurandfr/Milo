#!/bin/bash
# milo-presence-record — The challenge a proof of presence by power cut waits on
#
# Usage: printf '%s %s %s\n' <id> <action> <token_sha256> | milo-presence-record arm
#        milo-presence-record clear
#
# On a unit with neither a rotary encoder nor a Raspberry Pi 5's power button,
# the proof of presence (backend/core/system/presence.py) is a power cut: the
# challenge is recorded here with the boot it was opened in, and
# milo-backend.service's `ExecStopPost=+… clear` removes it at every stop of
# the backend — asked for, crashed, killed or timed out alike. A record still
# here when the backend starts, from another boot, is a boot no stop came
# before.
#
# Why root, and why this directory: every `milo` process can write
# /var/lib/milo, and a record any of them could write — or a marker any of them
# could withhold — is a proof a compromised daemon forges, with a token of its
# own choosing. Only root writes /var/lib/milo-presence, and only the backend
# reaches this helper: every other unit running as `milo` has
# NoNewPrivileges=true, so sudo is not theirs. The boot id is read here, never
# taken from the caller.
#
# `arm` takes its challenge on stdin and `clear` nothing; any other argument is
# refused. Must be run as root (sudoers for the backend; the unit's
# ExecStopPost=+ for `clear`).

set -euo pipefail

RECORD_DIR="/var/lib/milo-presence"
RECORD="$RECORD_DIR/challenge.json"
BOOT_ID_FILE="/proc/sys/kernel/random/boot_id"

usage() {
    echo "Usage: milo-presence-record arm|clear (arm reads '<id> <action> <sha256>' on stdin)" >&2
    exit 1
}

(( $# == 1 )) || usage

case "$1" in
    arm)
        # A terminal on stdin means the caller passed nothing to read; `read`
        # would block forever holding a sudo session open.
        if [[ -t 0 ]]; then
            echo "ERROR: the challenge must be piped on stdin" >&2
            exit 1
        fi
        ID="" ACTION="" DIGEST="" REST=""
        IFS=' ' read -r ID ACTION DIGEST REST || true
        # Each field by shape, so nothing but these characters reaches the JSON
        # written below.
        if [[ -n "$REST" ]] \
            || ! [[ "$ID" =~ ^[A-Za-z0-9_-]{8,32}$ ]] \
            || ! [[ "$ACTION" =~ ^[a-z_]{1,32}$ ]] \
            || ! [[ "$DIGEST" =~ ^[0-9a-f]{64}$ ]]; then
            echo "ERROR: expected '<id> <action> <sha256>' on stdin" >&2
            exit 1
        fi
        BOOT_ID="$(tr -d '\n' < "$BOOT_ID_FILE")"
        if ! [[ "$BOOT_ID" =~ ^[0-9a-f-]{36}$ ]]; then
            echo "ERROR: no boot id at $BOOT_ID_FILE: a power cut cannot be told from a restart" >&2
            exit 1
        fi
        mkdir -p "$RECORD_DIR"
        chmod 0755 "$RECORD_DIR"
        TMP="$RECORD_DIR/.challenge.json.new"
        printf '{"id": "%s", "action": "%s", "token_sha256": "%s", "boot_id": "%s"}\n' \
            "$ID" "$ACTION" "$DIGEST" "$BOOT_ID" > "$TMP"
        chmod 0644 "$TMP"
        # On the card before the dialog asks for the plug to be pulled: ext4
        # would otherwise hold the write for up to 5 s, and a cut inside them
        # loses it.
        sync "$TMP"
        mv -f "$TMP" "$RECORD"
        sync "$RECORD_DIR"
        ;;
    clear)
        rm -f "$RECORD"
        # The removal is what matters, and it is done: a stop that goes on to
        # reboot syncs the card itself, and a failed flush here must not mark
        # the backend's stop as failed.
        if [[ -d "$RECORD_DIR" ]]; then
            sync "$RECORD_DIR" || true
        fi
        ;;
    *)
        usage
        ;;
esac
