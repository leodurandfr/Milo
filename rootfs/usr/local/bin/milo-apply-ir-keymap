#!/bin/bash
# milo-apply-ir-keymap — Install and load a Milo-managed rc-core keymap.
#
# Invoked from the backend (keymap_writer.apply_keymap / clear_kernel_keymap)
# via the sudoers-protected entry in /etc/sudoers.d/milo-ir-remote.
#
# Usage:
#   milo-apply-ir-keymap                # read TOML from stdin, install + load
#   milo-apply-ir-keymap --clear        # clear the active keymap + remove file
#
# Installing reads the keymap TOML from stdin, validates it, writes it
# atomically to /etc/rc_keymaps/milo-apple-remote.toml, then loads it via
# ir-keytable. Doing the file write inside the privileged helper means the
# backend (running as `milo`) never needs to touch /etc/rc_keymaps/.

set -euo pipefail

INSTALL_PATH="/etc/rc_keymaps/milo-apple-remote.toml"
INSTALL_DIR="$(dirname "$INSTALL_PATH")"

usage() {
    echo "Usage: $0 [--clear]" >&2
    exit 1
}

# Accept exactly: no args (install from stdin), or `--clear`. Anything else
# is rejected — silently falling through to the stdin path on an unknown arg
# would mask caller bugs.
if [[ $# -gt 1 ]]; then
    usage
fi
if [[ $# -eq 1 && "$1" != "--clear" ]]; then
    usage
fi

# Locate the rc-core device backed by gpio_ir_recv.
find_rc_device() {
    local rc_dev=""
    local current=""

    while IFS= read -r line; do
        if [[ "$line" =~ ^Found\ /sys/class/rc/(rc[0-9]+)/ ]]; then
            current="${BASH_REMATCH[1]}"
        elif [[ -n "$current" && "$line" =~ Driver:\ gpio_ir_recv ]]; then
            rc_dev="$current"
            break
        fi
    done < <(ir-keytable 2>&1 || true)

    echo "$rc_dev"
}

RC_DEV=$(find_rc_device)
if [[ -z "$RC_DEV" ]]; then
    echo "milo-apply-ir-keymap: gpio_ir_recv device not found" >&2
    exit 2
fi

# Re-enable NEC every time — `ir-keytable --clear` drops the protocol set too,
# and a fresh boot before milo-ir-keytable.service ran would leave NEC off.
ir-keytable -s "$RC_DEV" -p nec >/dev/null

if [[ "${1:-}" == "--clear" ]]; then
    ir-keytable -s "$RC_DEV" -c >/dev/null
    rm -f "$INSTALL_PATH"
    exit 0
fi

# Read TOML content from stdin to a temp file inside the target directory
# so the final `mv` is an atomic rename (same filesystem).
mkdir -p "$INSTALL_DIR"
TMPFILE=$(mktemp "$INSTALL_DIR/.milo-apple-remote.XXXXXX.toml")
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE"

# Basic content validation — refuse anything that doesn't look like our keymap.
if ! grep -q '^variant = "nec-32"' "$TMPFILE"; then
    echo "milo-apply-ir-keymap: rejected stdin payload (missing nec-32 variant)" >&2
    exit 3
fi
if ! grep -q '^\[protocols.scancodes\]' "$TMPFILE"; then
    echo "milo-apply-ir-keymap: rejected stdin payload (missing scancodes block)" >&2
    exit 3
fi

chmod 0644 "$TMPFILE"
mv "$TMPFILE" "$INSTALL_PATH"
trap - EXIT

ir-keytable -s "$RC_DEV" --write="$INSTALL_PATH" >/dev/null
exit 0
