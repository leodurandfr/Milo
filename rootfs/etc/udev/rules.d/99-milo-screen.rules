# Milo Screen Brightness Control - udev rules
# Allows milo user to control screen brightness without sudo

# Waveshare 7" USB screen - grant access to hidraw devices
# The brightness binary communicates via HID
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", MODE="0666"

# Waveshare 8" DSI screen - grant write access to backlight brightness
# This rule runs when backlight device is added
SUBSYSTEM=="backlight", ACTION=="add", RUN+="/bin/chmod 0666 /sys/class/backlight/%k/brightness"

# Waveshare DSI touch (Goodix) - poll every 5 ms instead of the driver's 17 ms
# The DSI ribbon carries no touch interrupt, so the driver polls. At 17 ms
# (rounded up to 20 by HZ=250, plus ~4 ms of I2C read) the finger was sampled
# at 41.7 Hz on a 60 Hz panel and every drag stuttered. 5 ms measured 62.5 Hz
# (2026-10-16). TEST keeps the rule inert on a Goodix wired with an interrupt,
# which has no poll attribute.
SUBSYSTEM=="input", ACTION!="remove", KERNEL=="input*", DRIVERS=="Goodix-TS", TEST=="poll", ATTR{poll}="5"

# Kiosk compositor - no pointer, so Chromium's buffer is scanned out directly
# The IR receiver and the two HDMI-CEC inputs advertise relative axes, so
# libinput calls them pointers and cage keeps a cursor, invisible but drawn. The
# DSI panel has no cursor plane, so that cursor made cage composite every frame:
# ~33 ms between Chromium's frame and the panel (finger to panel 82 -> 49 ms
# without it, measured 2026-10-16). Hidden from libinput only: the backend reads
# the IR remote through evdev, which this does not touch. IR keys no longer reach
# Chromium as keystrokes, so they no longer count as screen activity: on purpose,
# playback wakes the screen.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gpio_ir_recv", ENV{LIBINPUT_IGNORE_DEVICE}="1"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="vc4-hdmi-*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
