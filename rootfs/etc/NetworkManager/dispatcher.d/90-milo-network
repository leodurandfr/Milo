#!/bin/bash
# Milo Network Manager - Avahi mDNS interface selection
#
# Picks which interface Avahi advertises milo.local on (single-interface
# advertising avoids the self-loop hostname conflict milo.local -> milo-2.local
# without sacrificing WiFi as a fallback).
#
# Energy Efficient Ethernet is not handled here: config.txt turns it off in the
# PHY (dtparam=eee=off, provisioning/system.sh). Switching it off from a script
# renegotiates a link that is already up — 3 s down at every boot, measured.
#
# Backend network status is no longer driven from here — NetworkService now
# subscribes directly to NetworkManager's D-Bus signals on eth0 + wlan0
# (State / Ip4Config / ActiveConnection / AP Strength), so the live UI
# refresh runs without a dispatcher round-trip and without racing DHCP.
#
# Avahi interface state is persisted in AVAHI_STATE_FILE and applied by the
# avahi-daemon systemd ExecStartPre override on every Avahi start.
#
# Selection rules (in priority order):
# - eth0 has an IPv4 address:               Avahi on eth0  (ethernet preferred)
# - WiFi running the captive hotspot SSID: Avahi on wlan0 (setup mode)
# - else:                                   Avahi on wlan0 (WiFi fallback),
#   once eth0 is not about to get a lease (see wait_for_eth0_lease)
#
# Ethernet outranks the hotspot rule: a device that has both is reachable on the
# LAN, and advertising milo.local on the AP subnet instead would hide it from
# every other device on the network.

INTERFACE=$1
ACTION=$2
AVAHI_CONF="/etc/avahi/avahi-daemon.conf"
AVAHI_STATE_FILE="/var/lib/milo/avahi-interface"
ETH0_ACTIVATION_CAP_S=45

# Setup hotspot SSID (shared across all Milō devices)
is_hotspot_connection() {
    case "$1" in
        Milō) return 0 ;;
        *) return 1 ;;
    esac
}

# Get current Avahi interface configuration
get_avahi_interface() {
    grep "^allow-interfaces=" "$AVAHI_CONF" 2>/dev/null | cut -d= -f2
}

# Check if interface has an IPv4 address
has_ip() {
    ip -4 addr show "$1" 2>/dev/null | grep -q "inet "
}

# Get the active NM connection name on wlan0
get_wlan0_connection() {
    nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | \
        grep ":wlan0$" | cut -d: -f1
}

# Update Avahi interface - writes to state file then restarts Avahi
set_avahi_interface() {
    local interface="$1"
    local current
    current=$(get_avahi_interface)

    # Skip if already configured correctly
    [ "$current" = "$interface" ] && return 0

    # Write desired interface to state file (applied by systemd ExecStartPre)
    echo "$interface" > "$AVAHI_STATE_FILE"

    # Restart Avahi - ExecStartPre will read state file and apply correct interface
    systemctl restart avahi-daemon.service
}

# Wait while NetworkManager is still bringing eth0 up (device states 40-90,
# prepare .. secondaries). At boot wlan0 can lease first: on 2026-10-14 eth0 had
# carrier at 22.1 s and its lease at 42.4 s, wlan0 its lease at 26.0 s, and
# milo.local published on wlan0 in between sent a satellite to that address.
# 90-milo-ethernet-ipv4.conf keeps eth0 activating until it has IPv4 (or 30 s
# of trying), so NetworkManager decides how long; a cable that is absent, or a
# profile that never activates, waits nothing. The cap only guards against a
# state that never settles: NetworkManager's DHCP transaction lasts 45 s.
# Timed on /proc/uptime: the Pi has no RTC and timesyncd steps the wall clock
# mid-boot, which would cut a wall-clock wait short.
# A cable that drops while eth0 activates (NetworkManager then calls the device
# unavailable, 20, once the drop outlasts its few seconds of grace) is a flap,
# not an unplugged cable: once eth0 was seen activating, only the cap ends the
# wait.
eth0_state() {
    local state
    state=$(nmcli -g GENERAL.STATE device show eth0 2>/dev/null)
    state=${state%% *}
    [[ "$state" =~ ^[0-9]+$ ]] && echo "$state" || echo 0
}

wait_for_eth0_lease() {
    local up _ deadline state activated=false
    read -r up _ < /proc/uptime
    deadline=$(( ${up%.*} + ETH0_ACTIVATION_CAP_S ))
    while ! has_ip eth0; do
        state=$(eth0_state)
        if (( state >= 40 && state < 100 )); then
            activated=true
        elif ! { $activated && (( state == 20 )); }; then
            return 0
        fi
        read -r up _ < /proc/uptime
        (( ${up%.*} < deadline )) || return 0
        sleep 0.5
    done
}

# Decide and apply the correct Avahi interface for the current network state.
# Called from every dispatcher event so the choice always reflects reality,
# regardless of which interface triggered the event.
apply_avahi_target() {
    local wlan_conn
    wlan_conn=$(get_wlan0_connection)

    if has_ip eth0; then
        set_avahi_interface "eth0"
    elif is_hotspot_connection "$wlan_conn"; then
        set_avahi_interface "wlan0"
    elif has_ip wlan0; then
        wait_for_eth0_lease
        if has_ip eth0; then
            set_avahi_interface "eth0"
        else
            set_avahi_interface "wlan0"
        fi
    fi
    # If neither interface has an IP, leave the state file alone — Avahi will
    # pick up the right one on the next up event.
}

# dhcp4-change matters on its own, on both interfaces: NM activates a device as
# soon as IPv6 is up and fires `up` then, so the IPv4 lease — the thing has_ip
# tests — often lands after the only event we would otherwise see. Measured on
# wlan0: `up` 1.5 s before its lease, and milo.local stayed published nowhere.
case "$INTERFACE" in
    eth0)
        case "$ACTION" in
            up|dhcp4-change|down)
                apply_avahi_target
                ;;
        esac
        ;;
    wlan0)
        case "$ACTION" in
            up|dhcp4-change|down)
                apply_avahi_target
                ;;
        esac
        ;;
esac

exit 0
