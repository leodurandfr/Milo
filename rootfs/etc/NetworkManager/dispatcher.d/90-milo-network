#!/bin/bash
# Milo Network Manager - Avahi mDNS interface selection + EEE disable
#
# Two responsibilities:
#   1. Pick which interface Avahi advertises milo.local on (single-interface
#      advertising avoids the self-loop hostname conflict
#      milo.local -> milo-2.local without sacrificing WiFi as a fallback).
#   2. Disable Energy Efficient Ethernet on eth0 link-up to keep Snapcast
#      buffers happy.
#
# Backend network status is no longer driven from here — NetworkService now
# subscribes directly to NetworkManager's D-Bus signals on eth0 + wlan0
# (State / Ip4Config / ActiveConnection / AP Strength), so the live UI
# refresh runs without a dispatcher round-trip and without racing DHCP.
#
# Avahi interface state is persisted in AVAHI_STATE_FILE and applied by the
# avahi-daemon systemd ExecStartPre override on every Avahi start.
#
# Selection rules (in priority order):
# - WiFi running the captive hotspot SSID: Avahi on wlan0 (setup mode)
# - eth0 has an IPv4 address:               Avahi on eth0  (ethernet preferred)
# - else:                                   Avahi on wlan0 (WiFi fallback)

INTERFACE=$1
ACTION=$2
AVAHI_CONF="/etc/avahi/avahi-daemon.conf"
AVAHI_STATE_FILE="/var/lib/milo/avahi-interface"

# Setup hotspot SSID (shared across all Milō devices)
is_hotspot_connection() {
    case "$1" in
        Milō) return 0 ;;
        *) return 1 ;;
    esac
}

# Get current Avahi interface configuration
get_avahi_interface() {
    grep "^allow-interfaces=" "$AVAHI_CONF" 2>/dev/null | cut -d= -f2
}

# Check if interface has an IPv4 address
has_ip() {
    ip -4 addr show "$1" 2>/dev/null | grep -q "inet "
}

# Get the active NM connection name on wlan0
get_wlan0_connection() {
    nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | \
        grep ":wlan0$" | cut -d: -f1
}

# Disable Energy Efficient Ethernet on a wired interface.
# EEE/LPI causes micro-pauses on link wake-up that produce TCP retransmissions
# and Snapcast buffer underruns on the multiroom audio path.
disable_eee() {
    local iface="$1"
    [ -x /usr/sbin/ethtool ] || return 0
    /usr/sbin/ethtool --show-eee "$iface" 2>/dev/null | \
        grep -q "EEE status: enabled" || return 0
    if ! /usr/sbin/ethtool --set-eee "$iface" eee off >/dev/null 2>&1; then
        logger -t milo-network "EEE disable unsupported on $iface (driver limitation)"
    fi
}

# Update Avahi interface - writes to state file then restarts Avahi
set_avahi_interface() {
    local interface="$1"
    local current
    current=$(get_avahi_interface)

    # Skip if already configured correctly
    [ "$current" = "$interface" ] && return 0

    # Write desired interface to state file (applied by systemd ExecStartPre)
    echo "$interface" > "$AVAHI_STATE_FILE"

    # Restart Avahi - ExecStartPre will read state file and apply correct interface
    systemctl restart avahi-daemon.service
}

# Decide and apply the correct Avahi interface for the current network state.
# Called from every dispatcher event so the choice always reflects reality,
# regardless of which interface triggered the event.
apply_avahi_target() {
    local wlan_conn
    wlan_conn=$(get_wlan0_connection)

    if is_hotspot_connection "$wlan_conn"; then
        set_avahi_interface "wlan0"
    elif has_ip eth0; then
        set_avahi_interface "eth0"
    elif has_ip wlan0; then
        set_avahi_interface "wlan0"
    fi
    # If neither interface has an IP, leave the state file alone — Avahi will
    # pick up the right one on the next up event.
}

case "$INTERFACE" in
    eth0)
        case "$ACTION" in
            up)
                disable_eee eth0
                apply_avahi_target
                ;;
            down)
                apply_avahi_target
                ;;
        esac
        ;;
    wlan0)
        case "$ACTION" in
            up|down)
                apply_avahi_target
                ;;
        esac
        ;;
esac

exit 0
