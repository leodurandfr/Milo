#!/bin/bash
# Milo Network Manager - Unified WiFi/Ethernet management
#
# Handles:
# - Ethernet priority over WiFi (disconnects WiFi when Ethernet is up)
# - Avahi mDNS interface management (switches to active interface)
#
# Avahi interface state is persisted in AVAHI_STATE_FILE.
# The systemd ExecStartPre reads this file to apply the correct interface.
# This dispatcher handles runtime network changes (cable plug/unplug).
#
# Scenarios:
# - Ethernet only: Avahi uses eth0
# - WiFi only: Avahi uses wlan0
# - Both: Ethernet prioritized, WiFi disconnected, Avahi uses eth0

INTERFACE=$1
ACTION=$2
AVAHI_CONF="/etc/avahi/avahi-daemon.conf"
AVAHI_STATE_FILE="/var/lib/milo/avahi-interface"
HOTSPOT_CON_NAME="Milō"

# Get current Avahi interface configuration
get_avahi_interface() {
    grep "^allow-interfaces=" "$AVAHI_CONF" 2>/dev/null | cut -d= -f2
}

# Check if interface has an IP address
has_ip() {
    ip addr show "$1" 2>/dev/null | grep -q "inet "
}

# Check if eth0 has carrier (cable connected) - means it's connecting or connected
eth0_has_carrier() {
    [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = "1" ]
}

# Get the active NM connection name on wlan0
get_wlan0_connection() {
    nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | \
        grep ":wlan0$" | cut -d: -f1
}

# Update Avahi interface - writes to state file then restarts Avahi
set_avahi_interface() {
    local interface="$1"
    local current
    current=$(get_avahi_interface)

    # Skip if already configured correctly
    [ "$current" = "$interface" ] && return 0

    # Write desired interface to state file (will be applied by systemd ExecStartPre)
    echo "$interface" > "$AVAHI_STATE_FILE"

    # Restart Avahi - ExecStartPre will read state file and apply correct interface
    systemctl restart avahi-daemon.service
}

case "$INTERFACE" in
    eth0)
        case "$ACTION" in
            up)
                # Ethernet is now up - this is the preferred interface

                # 1. Disconnect WiFi unless hotspot is active (managed by backend)
                active_conn=$(get_wlan0_connection)
                if [ -n "$active_conn" ] && [ "$active_conn" != "$HOTSPOT_CON_NAME" ]; then
                    nmcli device disconnect wlan0 2>/dev/null
                fi

                # 2. Ensure Avahi uses eth0
                set_avahi_interface "eth0"
                ;;
            down)
                # Ethernet went down - failover to WiFi if available
                if has_ip wlan0; then
                    set_avahi_interface "wlan0"
                fi
                ;;
        esac
        ;;
    wlan0)
        case "$ACTION" in
            up)
                # WiFi is now up - only use it if eth0 is not available
                active_conn=$(get_wlan0_connection)

                if [ "$active_conn" = "$HOTSPOT_CON_NAME" ]; then
                    # Hotspot is managed by the backend - do not disconnect
                    set_avahi_interface "wlan0"
                elif has_ip eth0 || eth0_has_carrier; then
                    # Ethernet is active or coming up - disconnect WiFi
                    nmcli device disconnect wlan0 2>/dev/null
                else
                    # Ethernet not available - use WiFi
                    set_avahi_interface "wlan0"
                fi
                ;;
        esac
        ;;
esac

exit 0
