{
  "name": "milo-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "npm run lint:css && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:check:fix": "node scripts/check-i18n.js --fix",
    "i18n:check:full": "node scripts/check-i18n.js --unused",
    "i18n:cleanup": "node scripts/cleanup-i18n.js",
    "i18n:cleanup:apply": "node scripts/cleanup-i18n.js --apply",
    "lint:js": "eslint 'src/**/*.{js,vue}' --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.{vue,css}'",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.1.0",
    "knip": "^5.82.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.11.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
