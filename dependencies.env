# Milō — the validated dependency set.
#
# One version per dependency Milō ships, and the ONLY place any of them is
# declared. Three consumers read this file and none of them restates a number:
#
#   provisioning/*.sh            sourced through provisioning/common.sh, which
#                                every pi-gen stage block sources first
#   pi-gen/stage-milo/*/*-run.sh sourced as a sibling; pi-gen/build.sh copies
#                                this file in next to the stage, because a stage
#                                is built from a copy that cannot reach the repo
#   backend/core/updates/        read by dependency_versions.py, which fills each
#                                catalog entry's "validated_version"
#
# Shell-sourceable `KEY=value` on purpose: bash must read it before apt has run
# (Raspberry Pi OS Lite ships no `jq`), and Python reads it with a 3-line parse.
#
# Two kinds of line, told apart by their suffix:
#
#   *_VERSION   a bare version, never a tag. The `v` prefix — present for some
#               repos, absent for others — stays inline at each use site.
#   *_SHA256    the sha256 of one file that version downloads, beside the
#               version it belongs to. Every installer checks the file against
#               it as it downloads — the update flow, a satellite, the pi-gen
#               stage — before anything is built, unpacked or installed, and
#               refuses a mismatch. The .debs and the release tarballs are
#               checked again by the root helper that installs them, on a copy
#               only root can write (milo-deploy-update, a satellite's
#               milo-client-install-*); a source archive is checked once, before
#               its build or its unprivileged pip. So a version bumped without
#               its digests installs nowhere: bump them in one edit.
#
# A digest is taken by downloading the asset into an empty directory and hashing
# it (`sha256sum`), never by running it; where GitHub publishes the asset's own
# digest (the release API's `digest`), the two must agree. Only the version
# declared here has a digest: an install of what upstream published past it
# (`target: upstream`) has none to check, which is why it waits for a proof of
# presence.
#
# Bump a line only after validating that version against Milō's chain; see
# docs/development.md § Validating a dependency bump for what "validated" means
# per dependency.
#
# Adding a dependency without a line here fails CI, and so does an asset without
# its digest: backend/tests/architecture/test_dependency_manifest.py
#
# One dependency is deliberately absent: the Tidal Connect daemon. It is a
# frozen 2020 armhf binary from Tidal's proprietary SDK, published only as a
# container image and pinned by DIGEST in provisioning/tidal_connect_runtime.py.
# There is no version to declare, no release to compare against, and a single
# consumer — so it has no catalog entry either. Do not add a TIDAL_VERSION line
# to "fix" the gap.

# ── Updatable from the UI (one entry each in backend/core/updates/catalog.py) ──

# Spotify Connect. Tags are "v{version}".
GO_LIBRESPOT_VERSION=0.10.7
# go-librespot_linux_arm64.tar.gz
GO_LIBRESPOT_SHA256=1959a87033c5d8ff012e6f8acd1ca1994234104455d9796b688c8d2193e7f28b

# AirPlay 2. Built from source; tags carry no "v".
# 5.0 and 5.1 delivered no AirPlay metadata at all — fixed upstream in 5.2.
# Moves with NQPTP_VERSION when the shared memory interface does (5.6: smi11).
SHAIRPORT_SYNC_VERSION=5.6.3
# The tag's source archive, archive/refs/tags/{version}.tar.gz (built on the unit).
SHAIRPORT_SYNC_SHA256=670f9cefdb9c2d70f7df71890e63ab0a31d08a815dd0734245d935bfd01e766e

# AirPlay 2 timing daemon. Tags carry no "v". No row of its own: the
# shairport-sync update installs this version alongside, and refuses a
# shairport-sync whose shared memory interface (SMI) it does not speak. A bump
# that moves the SMI must ship in a release after the one that taught the
# updater to pair them: a Milō update reconciles from the process it replaces.
NQPTP_VERSION=1.2.9
# The tag's source archive, archive/refs/tags/{version}.tar.gz (built on the unit).
NQPTP_SHA256=6aa1d73b8ee760bf19378c319db0d0537a867ff961764b150e19f87d96a02210

# Multiroom (snapserver + snapclient). Tags are "v{version}"; the .deb filenames
# embed the bare version.
SNAPCAST_VERSION=0.35.0
# snapserver_{version}-1_arm64_trixie.deb and snapclient_{version}-1_arm64_trixie.deb:
# snapcast publishes one .deb per Debian release, and trixie is the one every
# image is built on (pi-gen/config RELEASE). A unit on another release downloads
# another file, and is refused.
SNAPSERVER_SHA256=be0c94ea3551c4ba4f4e5f810b18f6c85d9794ab32e4fc6c5e6886e096490914
SNAPCLIENT_SHA256=eced4134eeab132fc16af23ce19eb2f81abe23dd0f3c610150fb3bd1d344efae

# The audio processor. Always in the audio path, so it is the one dependency
# whose service is stopped and restarted unconditionally on update.
CAMILLADSP_VERSION=4.1.3
# camilladsp-linux-aarch64.tar.gz, on the server and on every satellite.
CAMILLADSP_SHA256=d9a17092923ebfe5d20a770c6b6a7eb2268f9700f999bf604b9db09f518aca5a

# Qobuz Connect sidecar. Not on PyPI — pip installs the tag "v{version}".
QOBUZ_PROXY_VERSION=1.7.7
# The tag's source archive, archive/refs/tags/v{version}.tar.gz, which pip
# installs once it is checked — never `git+…@v{version}`, which nothing can hash.
QOBUZ_PROXY_SHA256=73584cc669b1bf4efeb51c46817761541dd7050dc77ad75c76a0a1062a0eab79

# Music Library catalog engine. Release asset embeds the bare version twice.
NAVIDROME_VERSION=0.64.2
# navidrome_{version}_linux_arm64.tar.gz
NAVIDROME_SHA256=6d1683428cb6d99cdabc3da815b94cc161de5904820130c5b9e2e42c34dcdb15

# ── Build-time only (compiled by the image build, never updatable in-app) ──────
# No catalog entry, so no in-app update offers them — but each was declared in
# two trees before this file existed, which is the same drift, unwatched. No
# digest either: the image build clones their tag.

# Bluetooth A2DP. Tags are "v{version}".
BLUEZ_ALSA_VERSION=4.3.1

# Mac streaming. Tags are "v{version}".
ROC_TOOLKIT_VERSION=0.4.0
