# Milō — the validated dependency set.
#
# One version per dependency Milō ships, and the ONLY place any of them is
# declared. Three consumers read this file and none of them restates a number:
#
#   provisioning/*.sh            sourced through provisioning/common.sh, which
#                                every pi-gen stage block sources first
#   pi-gen/stage-milo/*/*-run.sh sourced as a sibling; pi-gen/build.sh copies
#                                this file in next to the stage, because a stage
#                                is built from a copy that cannot reach the repo
#   backend/core/updates/        read by dependency_versions.py, which fills each
#                                catalog entry's "validated_version"
#
# Shell-sourceable `KEY=value` on purpose: bash must read it before apt has run
# (Raspberry Pi OS Lite ships no `jq`), and Python reads it with a 3-line parse.
#
# Values are bare versions, never tags. The `v` prefix — present for some repos,
# absent for others — stays inline at each use site, which is where it already
# was. Bump a line only after validating that version against Milō's chain; see
# docs/development.md § Validating a dependency bump for what "validated" means
# per dependency.
#
# Adding a dependency without a line here fails CI:
# backend/tests/architecture/test_dependency_manifest.py
#
# One dependency is deliberately absent: the Tidal Connect daemon. It is a
# frozen 2020 armhf binary from Tidal's proprietary SDK, published only as a
# container image and pinned by DIGEST in provisioning/tidal_connect_runtime.py.
# There is no version to declare, no release to compare against, and a single
# consumer — so it has no catalog entry either. Do not add a TIDAL_VERSION line
# to "fix" the gap.

# ── Updatable from the UI (one entry each in backend/core/updates/catalog.py) ──

# Spotify Connect. Tags are "v{version}".
GO_LIBRESPOT_VERSION=0.9.0

# AirPlay 2. Built from source; tags carry no "v".
# 5.0 and 5.1 delivered no AirPlay metadata at all — fixed upstream in 5.2.
SHAIRPORT_SYNC_VERSION=5.5

# Multiroom (snapserver + snapclient). Tags are "v{version}"; the .deb filenames
# embed the bare version.
SNAPCAST_VERSION=0.35.0

# The audio processor. Always in the audio path, so it is the one dependency
# whose service is stopped and restarted unconditionally on update.
CAMILLADSP_VERSION=4.1.3

# Qobuz Connect sidecar. Not on PyPI — pip installs the git tag "v{version}".
QOBUZ_PROXY_VERSION=1.7.0

# Music Library catalog engine. Release asset embeds the bare version twice.
NAVIDROME_VERSION=0.63.2

# ── Build-time only (compiled by both installers, never updatable in-app) ──────
# No catalog entry, so no in-app update offers them — but each was declared in
# two trees before this file existed, which is the same drift, unwatched.

# AirPlay 2 timing daemon. Tags carry no "v".
NQPTP_VERSION=1.2.4

# Bluetooth A2DP. Tags are "v{version}".
BLUEZ_ALSA_VERSION=4.3.1

# Mac streaming. Tags are "v{version}".
ROC_TOOLKIT_VERSION=0.4.0
