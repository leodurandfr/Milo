# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# The two deployment trees mirror a filesystem, so their real directories collide
# with the Python build-dir ignores above. Both roles need the re-include, not
# just the server's: milo-client/rootfs/usr/local/lib/ was swallowed by `lib/`,
# which is why hardware-helpers.sh could not be committed on the satellite side
# and every satellite reboot died sourcing a file no install path shipped.
lib/
!rootfs/var/lib/
!rootfs/usr/local/lib/
!milo-client/rootfs/usr/local/lib/
lib64/
parts/
sdist/
var/
!rootfs/var/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/

# Program
go-librespot/
bluez-alsa/
roc-toolkit/

# Frontend
node_modules/
/frontend/dist/
/frontend/node_modules/
/frontend/coverage/
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors
.idea/
.vscode/
*.swp
*.swo

# Ignore Claude doc
# /CLAUDE.md
.claude/
_bmad-output/
_bmad/


# Ignore personal docs
docs/website
docs/plans

# Vendored upstream docs are always tracked. They live in dirs named after the
# tool (docs/vendor/go-librespot/, ...) which would otherwise be caught by the
# broad build-dir ignores under "# Program" above (go-librespot/, roc-toolkit/,
# bluez-alsa/). Re-include the whole vendor tree.
!docs/vendor/
!docs/vendor/**
