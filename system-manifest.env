# Milō — what a unit's system holds besides its files.
#
# rootfs/ and system/ hold the files, and every Milō update installs every one
# of them. What a file cannot say is declared here, once: the packages, the
# managed lines of the boot partition's config.txt and cmdline.txt, and the
# state of the units. Two consumers read this file, and neither restates it:
#
#   pi-gen/stage-milo        the image. 00-install-deps installs the packages
#                            from a copy pi-gen/build.sh and the CI image builder
#                            place beside the stage, as they do dependencies.env
#                            (a stage cannot reach the repo); 03-configure runs
#                            `milo-deploy-update apply-system-manifest` in its
#                            chroot, over the checkout the image carries.
#   milo-deploy-update       every Milō update: `sync-system-files` reads the
#                            copy in the checkout it syncs, after the release's
#                            files are in place and before the reboot into it.
#
# So a unit updated to a release holds what a card flashed with that release
# holds. That is only true from the first image carrying this file on: an update
# is run by the installed milo-deploy-update, the departing release's.
#
# Bash arrays, sourced by bash as root (both consumers run as root; Raspberry Pi
# OS Lite ships no jq to read anything else before apt has run). One word per
# element; a `#` outside quotes is a comment, as anywhere in bash. The six names
# are frozen: one release's script reads another release's copy of this file
# (MANIFEST_ARRAYS in milo-deploy-update says why, and where a new one goes).
#
# Every declaration is additive: an update adds what is missing and never takes
# anything away. A package, a cmdline token or a unit state a later manifest
# drops stays on the unit, which is what lets the update guard's sync back to
# the previous release run offline, at boot, with nothing to install.
#
# Held by backend/tests/architecture/test_image_update_convergence.py: whatever
# pi-gen/stage-milo installs is declared here, comes from rootfs/ or system/,
# or is listed there with the reason no update has to install it again.

# ── Packages ─────────────────────────────────────────────────────────────────
# The image installs every one with its recommends (pi-gen's way); an update
# installs those missing, without recommends: a package Milō relies on is named
# here, never inherited from another's Recommends. That is also what keeps an
# update from pulling pulseaudio back in behind libpulse-dev (ALSA only).
SYSTEM_APT_PACKAGES=(
    # The checkout, its venvs, and the wheels built on the unit (evdev, lgpio)
    git python3-pip python3-venv python3-dev
    wget unzip bc xxd fontconfig
    # readelf, which the Tidal Connect runtime builder checks segments with
    binutils

    # Toolchain for what is compiled on the unit — shairport-sync and NQPTP by
    # the Update Manager, BlueALSA and roc-toolkit by the image build
    build-essential cmake pkg-config swig make
    autoconf automake autotools-dev libtool intltool
    scons ragel gengetopt

    # Headers those builds link against
    libasound2-dev libssl-dev liblgpio-dev
    libogg-dev libvorbis-dev libuv1-dev libspeexdsp-dev libunwind-dev
    libsox-dev libsndfile1-dev libpulse-dev
    libbluetooth-dev libdbus-1-dev libglib2.0-dev libsbc-dev libfreeaptx-dev
    libpopt-dev libconfig-dev libavahi-client-dev libsoxr-dev libplist-dev
    libsodium-dev libavutil-dev libavcodec-dev libavformat-dev
    uuid-dev libgcrypt20-dev libdiscid-dev

    # Audio, mDNS and Bluetooth at run time
    libasound2-plugins mpv libplist-utils
    avahi-daemon avahi-utils libavahi-client3 libavahi-common3
    bluez bluez-tools
    # qobuz-proxy's local backend (sounddevice)
    libportaudio2

    # CD: the SuperDrive's wake-up, the tray, the disc id
    sg3-utils eject libdiscid0

    # Radio logos, flattened onto a ground (cairosvg)
    libcairo2

    # The kiosk and the boot splash
    chromium cage seatd libinput-tools plymouth plymouth-themes
    fonts-noto fonts-noto-cjk fonts-lohit-deva fonts-noto-color-emoji

    # The web interface
    nginx

    # Music Library storage: USB file systems and network shares
    exfatprogs ntfs-3g dosfstools cifs-utils nfs-common smbclient

    # IR remote
    ir-keytable
)

# ── cmdline.txt ──────────────────────────────────────────────────────────────
# Every key a token here names is Milō's: each apply removes every token with
# that key (`console=serial0,115200` goes with `console`) and appends these, so
# a value changed here replaces the one on the unit. Every other token stays
# where it is, `root=` first of all.
SYSTEM_CMDLINE=(
    quiet splash plymouth.ignore-serial-consoles
    console=tty3 loglevel=0 consoleblank=0
    logo.nologo vt.global_cursor_default=0
    fbcon=map:99 vt.handoff=7
    # The Raspberry Pi device tree passes cgroup_disable=memory ahead of
    # cmdline.txt, so without this every unit's MemoryMax= is accepted by
    # systemd and enforced by nothing. The last occurrence wins.
    cgroup_enable=memory
)

# A seed is written only where its key is absent: from then on the key belongs
# to the program that sets it at run time. The radio's regulatory domain starts
# at the world domain, and milo-set-wifi-country writes the country the owner
# picks in the setup wizard — an update must not put 00 back over it.
SYSTEM_CMDLINE_SEED=(
    cfg80211.ieee80211_regdom=00
)

# ── config.txt ───────────────────────────────────────────────────────────────
# One block, `# BEGIN MILO SYSTEM` … `# END MILO SYSTEM`, holding these lines:
# appended once, then replaced in place by each apply, so it keeps its place
# before the blocks milo-apply-hardware owns (audio card, screen, IR, power
# LED), which are not declared here. It opens on [all] and an empty dtoverlay=:
# whatever the file ends on — a model filter, an overlay's scope — every line
# below applies to every board and to the base device tree.
SYSTEM_CONFIG_TXT=(
    "[all]"
    "dtoverlay="
    "# Energy Efficient Ethernet off in the PHY: Snapcast drops chunks at each LPI wake-up"
    "dtparam=eee=off"
    "# Pi 5 fan: four steps, audio first, quiet"
    "dtparam=cooling_fan=on"
    "dtparam=fan_temp0=66000"
    "dtparam=fan_temp0_hyst=2500"
    "dtparam=fan_temp0_speed=55"
    "dtparam=fan_temp1=79000"
    "dtparam=fan_temp1_hyst=2500"
    "dtparam=fan_temp1_speed=120"
    "dtparam=fan_temp2=81000"
    "dtparam=fan_temp2_hyst=2500"
    "dtparam=fan_temp2_speed=200"
    "dtparam=fan_temp3=82000"
    "dtparam=fan_temp3_hyst=2500"
    "dtparam=fan_temp3_speed=255"
    "# Silent boot"
    "disable_splash=1"
)

# ── Units ────────────────────────────────────────────────────────────────────
# Enabled, and masked, at every apply; never disabled or unmasked. A unit whose
# enablement something changes at run time is not listed: milo-kiosk follows
# the screen milo-apply-hardware is given, the source units and the two
# multiroom units are started by the backend, the satellite's are milo-first-
# boot's. A server converted to a satellite runs no Milō update.
SYSTEM_UNITS_ENABLED=(
    milo-first-boot.service
    milo-backend.service
    milo-readiness.service
    milo-camilladsp.service
    milo-bluealsa.service
    milo-bluealsa-aplay.service
    milo-cpu-governor.service
    milo-ir-keytable.service
    nqptp.service
    seatd.service
    avahi-daemon.service
    nginx.service
    # The IPv6 firewall (rootfs/etc/nftables.conf), in both roles
    nftables.service
)

SYSTEM_UNITS_MASKED=(
    # milo-readiness quits the splash itself
    plymouth-quit.service
    plymouth-quit-wait.service
    # The kiosk takes tty1
    getty@tty1.service
    # ~13 s at every boot, for nothing Milō waits on
    NetworkManager-wait-online.service
    # No display manager: cage runs the kiosk
    lightdm.service
)
