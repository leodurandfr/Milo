[Unit]
Description=Milo — reconcile the Navidrome catalog config (album-grouping PID) on boot
Documentation=https://www.navidrome.org/docs/usage/configuration/persistent-ids/

# The Navidrome TOML is baked by configure_navidrome(), but written once into
# /var/lib/milo (device data, not rootfs), so a normal app update — which only
# re-syncs system/ and rootfs/ — never refreshes it. This oneshot re-emits it
# from the single source of truth (install/navidrome.sh) before Navidrome starts,
# so a unit provisioned before an album-grouping/PID change picks it up. It reuses
# configure_navidrome() exactly like milo-eeprom-setup.service reuses its install
# function, and is idempotent: an unchanged rewrite is a no-op and Navidrome
# hashes the PID *value*, so only a genuine change forces the (full) rescan.
ConditionPathExists=/home/milo/milo/install/navidrome.sh
After=local-fs.target
Before=milo-navidrome.service

[Service]
Type=oneshot
RemainAfterExit=yes
# common.sh MUST be sourced before navidrome.sh: the latter's fallback
# `source "$(dirname "$0")/common.sh"` guard resolves $0 to /bin/bash here, so it
# would look for /bin/common.sh. Sourcing common.sh first defines log_* and makes
# that guard a no-op (same reason as milo-eeprom-setup.service).
ExecStart=/bin/bash -c 'cd /home/milo/milo && source install/common.sh && source install/navidrome.sh && configure_navidrome'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-navidrome-config

# No [Install] on purpose. This unit is pulled by Wants= from
# milo-navidrome.service and ordered ahead of it by the Before= above, which is
# why milo-first-boot's server-service list says it "needs no entry". A
# WantedBy=multi-user.target here was enabled by nothing — dead as it
# stood, and a trap if ever acted on: a converted satellite disables
# milo-navidrome but not this, so an enabled [Install] would re-emit a Navidrome
# catalog config at every boot on a machine that serves no catalog.
