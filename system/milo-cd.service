[Unit]
Description=Milo CD Player (mpv rawaudio via FIFO)
Documentation=https://mpv.io/manual/stable/
After=sound.target milo-backend.service milo-camilladsp.service
# Depends on ALSA environment configured by Milo
Requires=sound.target
BindsTo=milo-backend.service

[Service]
Type=simple
User=milo
Group=milo

# Automatically create /run/milo/ for IPC socket
RuntimeDirectory=milo
RuntimeDirectoryMode=0755
# Preserve the shared /run/milo on stop — see milo-camilladsp.service
RuntimeDirectoryPreserve=yes

# Load Milo environment variables (MILO_MODE)
EnvironmentFile=/var/lib/milo/routing.env

# The ALSA device milo_cd routes to direct (CamillaDSP) or multiroom (Snapcast)
ExecStartPre=/bin/sh -c 'echo "ALSA routing: MILO_MODE=${MILO_MODE}"'

# Launch mpv in daemon mode with IPC socket for CD playback
# Audio is fed as raw PCM via FIFO from the ioctl reader thread
ExecStart=/usr/bin/mpv \
    --no-video \
    --audio-device=alsa/milo_cd \
    --input-ipc-server=/run/milo/cd-ipc.sock \
    --idle=yes \
    --demuxer=rawaudio \
    --demuxer-rawaudio-rate=44100 \
    --demuxer-rawaudio-channels=stereo \
    --demuxer-rawaudio-format=s16le \
    --af=loudnorm=I=-14:TP=-1:LRA=11 \
    --no-cache \
    --msg-level=all=info \
    --no-config \
    --no-terminal \
    --really-quiet

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits (no 800MB cache — mpv just decodes raw PCM from FIFO)
CPUQuota=50%
MemoryMax=256M

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-cd

[Install]
WantedBy=multi-user.target
