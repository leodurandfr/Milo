[Unit]
Description=Milo Navidrome (Music Library catalog engine)
Documentation=https://www.navidrome.org/docs/
# Catalog daemon for the music_library source (unlike the per-source BindsTo
# units such as milo-music-library/radio/spotify, it runs whether or not the
# source is active: it serves the settings screen and indexes a key plugged in
# while another source plays). Localhost-only, indexes /media/milo. PartOf=, like
# milo-camilladsp/milo-snapserver-multiroom/milo-snapclient-multiroom, propagates
# both stop AND restart from the backend — BindsTo= only propagates stop, so a
# backend restart (crash, Restart=always, manual `systemctl restart`) would leave
# Navidrome dead until the whole appliance rebooted. After= only orders it behind
# the backend that starts it: the backend's clients wait for its port, not the unit.
#
# No [Install], like the two snapcast units: the backend owns its lifecycle.
# MusicLibrarySource.initialize starts it when the dock enables Music Library and
# stops it otherwise, and the dock toggle does the same. PartOf= never propagates
# start, so a `stop` + `start` of the backend relies on that to bring it back.
After=local-fs.target milo-backend.service
PartOf=milo-backend.service

# Re-apply the baked catalog config from the single source of truth before we
# start, so a device provisioned before an album-grouping/PID change picks it up
# (the TOML lives under /var/lib/milo, which app updates never refresh). Pulled in
# on every start — boot or on-demand — and ordered ahead of us by that unit's
# Before=. Idempotent; only a genuine PID change makes Navidrome rescan.
Wants=milo-navidrome-config.service

[Service]
Type=simple
User=milo
Group=milo

# Provision the service-account password on first boot (idempotent): generates
# the milo-owned 0600 cred file + the auth env file consumed below. Runs as milo,
# writes only under /var/lib/milo/navidrome — no privilege, no sudoers entry.
ExecStartPre=/usr/local/bin/milo-navidrome-provision

# Static config lives in the baked TOML; only the generated admin password is
# device-specific. Source the provisioning env file at exec time (set -a exports
# ND_DEVAUTOCREATEADMINPASSWORD) so it is guaranteed present — an EnvironmentFile=
# is resolved before ExecStartPre runs and would miss a first-boot-generated file.
Environment=HOME=/home/milo
Environment=ND_CONFIGFILE=/var/lib/milo/navidrome/navidrome.toml
ExecStart=/bin/sh -c 'set -a; . /var/lib/milo/navidrome/navidrome-auth.env; exec /usr/local/bin/navidrome'

WorkingDirectory=/var/lib/milo/navidrome
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10

# Resource limits — a first scan of a large library is memory-hungry.
MemoryMax=512M

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-navidrome
