[Unit]
Description=Milo Spotify Connect via go-librespot
After=network-online.target sound.target milo-backend.service milo-camilladsp.service
Wants=network-online.target
BindsTo=milo-backend.service

[Service]
Type=simple
User=milo
Group=audio

ExecStart=/usr/local/bin/go-librespot --config_dir /var/lib/milo/go-librespot
Environment=HOME=/home/milo
EnvironmentFile=/var/lib/milo/routing.env
WorkingDirectory=/var/lib/milo
Restart=always
RestartSec=5
# go-librespot exits gracefully on SIGTERM even with a live AP/dealer session —
# the case 0.7.2 hung on for the full TimeoutStopSec (fixed upstream in commit
# c191a43 "proper shutdown sequence on interrupt"). Re-measured on 0.8.0 on the
# Pi 2026-08-03, this time on a session actively playing: Stopping → Deactivated
# in 3.8ms (0.7.3 was 59ms, 2026-05-26, via a direct kill -TERM). So systemd's
# default SIGTERM stop is clean; TimeoutStopSec=5 is just a backstop in case a
# future upstream regression reappears.
TimeoutStopSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-spotify
MemoryMax=256M

[Install]
WantedBy=multi-user.target
