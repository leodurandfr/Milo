[Unit]
Description=BlueALSA player for Milo
Requires=milo-bluealsa.service sound.target
After=milo-bluealsa.service milo-backend.service milo-camilladsp.service sound.target
BindsTo=milo-backend.service milo-bluealsa.service

[Service]
EnvironmentFile=/var/lib/milo/routing.env
Type=simple
User=milo
Group=audio

ExecStart=/usr/bin/bluealsa-aplay --pcm=milo_bluetooth --volume=none --profile-a2dp 00:00:00:00:00:00

RestartSec=2
Restart=always
PrivateTmp=false
PrivateDevices=false
MemoryMax=64M

# Security hardening: no sudo (the backend's grants stay its own), and the
# backend's checkout under /home stays out of reach.
NoNewPrivileges=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
