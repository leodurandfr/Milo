[Unit]
Description=Milo Kiosk Mode (Cage + Chromium)
After=milo-readiness.service seatd.service
# seatd is a real requirement (no seat, no compositor). milo-readiness is only an
# ordering: it exists to hand the screen over, and Wants= + After= still waits for
# it to finish either way. Requires= made a readiness that failed — or that was
# stopped along with the backend — mean no UI at all, which is the one outcome a
# splash-handover unit must never be able to cause.
Wants=milo-readiness.service
Requires=seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=milo
Group=milo

# Ephemeral Chromium profile directory in /run/milo-kiosk (tmpfs, recreated
# on every start). The ephemeral profile avoids stale Singleton locks tied to
# the previous hostname or PID after reboots and unclean shutdowns.
RuntimeDirectory=milo-kiosk
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# Supplementary groups for seatd access
SupplementaryGroups=video

# Take control of tty1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

# Environment variables for Wayland/Cage.
# XDG_RUNTIME_DIR is /run/milo-kiosk, not /run/user/1000: logind mounts its own
# tmpfs over the latter at the first login, which hides the wayland-0 socket
# cage bound at boot. The compositor keeps working, but no client can reach it.
Environment=XDG_RUNTIME_DIR=/run/milo-kiosk
Environment=XCURSOR_THEME=Adwaita
Environment=XCURSOR_SIZE=24
Environment=WLR_XCURSOR_THEME=Adwaita
Environment=WLR_XCURSOR_SIZE=24

# The interface scale (Settings > Screen), written by the backend before it
# answers, applied as Chromium's default page zoom by milo-kiosk-zoom (see why
# there, not --force-device-scale-factor); restarting the kiosk is how a new
# value reaches Chromium. The default covers a first boot that has not written it.
Environment=MILO_UI_SCALE=1
EnvironmentFile=-/var/lib/milo/kiosk.env
ExecStartPre=/usr/local/bin/milo-kiosk-zoom

# Launch Cage with Chromium in kiosk mode
# --touch-slop-distance: how far a finger moves before Chromium calls it a scroll
# rather than a tap. Its default, 15 DIP, is 15 panel px here (device scale 1),
# ~2 mm on the 8" Waveshare against ~1.3 mm on a phone, and those pixels are
# subtracted from the scroll: a slow drag sat still for ~200 ms, then trailed the
# finger by 2 mm for good. 10 px (~1.35 mm, measured 2026-11-12) keeps a tap
# with a slightly sliding finger a tap.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --user-data-dir=/run/milo-kiosk/chromium \
  --kiosk \
  --incognito \
  --password-store=basic \
  --no-first-run \
  --disable-infobars \
  --disable-notifications \
  --disable-popup-blocking \
  --disable-session-crashed-bubble \
  --disable-restore-session-state \
  --disable-renderer-accessibility \
  --disable-translate \
  --disable-sync \
  --hide-scrollbars \
  --disable-background-networking \
  --autoplay-policy=no-user-gesture-required \
  --start-fullscreen \
  --disable-dev-shm-usage \
  --touch-events=enabled \
  --touch-slop-distance=10 \
  --enable-features=TouchpadAndWheelScrollLatching \
  --force-device-scale-factor=1 \
  --disable-pinch \
  --ignore-gpu-blocklist \
  --enable-gpu-rasterization \
  --enable-zero-copy \
  --app=http://localhost

Restart=always
RestartSec=3
# A cage stopped while still starting ignored SIGTERM until the default 90 s
# stop timeout, a black screen all along (measured 2026-10-07). The profile is
# ephemeral, so a SIGKILL loses nothing.
TimeoutStopSec=5
MemoryMax=1536M

# Security hardening: no sudo (the backend's grants stay its own). Chromium's
# setuid chrome-sandbox cannot run under it; its user-namespace sandbox does.
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
