[Unit]
Description=Milo Qobuz Connect via qobuz-proxy
After=network-online.target sound.target milo-backend.service milo-camilladsp.service
Wants=network-online.target
BindsTo=milo-backend.service

[Service]
Type=simple
User=milo
Group=audio

# Through Milō's launcher, not the console script: it applies the two
# adaptations upstream has no setting for (unity-gain volume policy,
# position/duration in /api/status) and refuses to start on a release
# that moved either of them.
ExecStart=/var/lib/milo/qobuz/venv/bin/python /usr/local/bin/milo-qobuz --config /var/lib/milo/qobuz/config.yaml
Environment=HOME=/home/milo
# Force qobuz-proxy's config + OAuth token cache under the D3 data dir
# (/var/lib/milo/qobuz), owned/writable by the milo user (see PLAN_QOBUZ D3).
Environment=QOBUZPROXY_DATA_DIR=/var/lib/milo/qobuz
# routing.env supplies MILO_MODE (direct|multiroom); the milo_qobuz ALSA PCM
# switches its backing device on it, same wiring as every other source.
EnvironmentFile=/var/lib/milo/routing.env
WorkingDirectory=/var/lib/milo
Restart=always
RestartSec=5
TimeoutStopSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-qobuz
MemoryMax=256M

[Install]
WantedBy=multi-user.target
