[Unit]
Description=Milo CamillaDSP Audio Processor
Documentation=https://github.com/HEnquist/camilladsp
After=sound.target
Requires=sound.target
PartOf=milo-backend.service

[Service]
Type=simple
User=milo
Group=milo

# CamillaDSP configuration and data directory.
# Preserve=yes: /run/milo is shared with the mpv source units — a Preserve=no
# stop/restart here (e.g. Restart=on-failure) would delete it under a playing
# source and break its IPC socket. All sharers keep it; tmpfs clears it on boot.
RuntimeDirectory=milo
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Working directory for config files
WorkingDirectory=/var/lib/milo/camilladsp

# Pin the card's hardware mixer at unity before CamillaDSP opens it — CamillaDSP
# is the only volume stage, the card must not attenuate on top of it. Leading "-"
# so a mixer problem can never keep audio down.
ExecStartPre=-/usr/local/bin/milo-alsa-passthrough

# Start CamillaDSP with WebSocket server enabled
# -p 1234: WebSocket server port
# -a 127.0.0.1: Listen only on localhost
# -m: Start muted - backend will unmute after setting correct volume
# -w: Wait for valid config before processing
# --gain=-60.0: Safe startup volume (restored by backend after init)
ExecStart=/usr/local/bin/camilladsp \
    -p 1234 \
    -a 127.0.0.1 \
    -m \
    -w \
    --gain=-60.0 \
    /var/lib/milo/camilladsp/config.yml

# Restart policy
Restart=on-failure
RestartSec=3s

# Resource limits
MemoryMax=256M

CPUSchedulingPolicy=fifo
CPUSchedulingPriority=15
LimitRTPRIO=20
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-camilladsp

[Install]
WantedBy=multi-user.target
