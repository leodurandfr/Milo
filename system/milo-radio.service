[Unit]
Description=Milo Radio Player (mpv)
Documentation=https://mpv.io/manual/stable/
After=sound.target milo-backend.service milo-camilladsp.service
# Depends on ALSA environment configured by Milo
Requires=sound.target
BindsTo=milo-backend.service

[Service]
Type=simple
User=milo
Group=milo

# Automatically create /run/milo/ for IPC socket
RuntimeDirectory=milo
RuntimeDirectoryMode=0755
# Preserve the shared /run/milo on stop — see milo-camilladsp.service
RuntimeDirectoryPreserve=yes

# Load Milo environment variables (MILO_MODE)
EnvironmentFile=/var/lib/milo/routing.env

# The ALSA device milo_radio routes to direct (CamillaDSP) or multiroom (Snapcast)
ExecStartPre=/bin/sh -c 'echo "ALSA routing: MILO_MODE=${MILO_MODE}"'

# Launch mpv in daemon mode with IPC socket
#
# --user-agent: Infomaniak's AIS9 streaming server (Nova among the stations it
# hosts) splices a 15-30 s ad over the first seconds of the live stream on
# every new connection whose User-Agent is a known player. Measured 2026-11-27
# on nova-odn.ice.infomaniak.ch, by aligning each connection's audio against a
# continuous reference: mpv's default `libmpv`, VLC, GStreamer, Chrome, Firefox
# and `Milo/1.0` all get the ad (and `Lavf/…`, whose ffprobe reads its
# `insertionType=preroll` tag); `curl/…` and `python-requests/…` get the live
# stream from the first second. The 25 most-played French stations on
# radio-browser play the same under `libmpv` and this agent. Shazam's captures
# send it too (sources/radio/shazam.py::STREAM_USER_AGENT), held equal by
# backend/tests/architecture/test_radio_user_agent.py.
ExecStart=/usr/bin/mpv \
    --no-video \
    --audio-device=alsa/milo_radio \
    --user-agent=curl/8.7.1 \
    --input-ipc-server=/run/milo/radio-ipc.sock \
    --idle=yes \
    --cache=yes \
    --demuxer-max-bytes=50MiB \
    --demuxer-max-back-bytes=5MiB \
    --network-timeout=15 \
    --stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_on_network_error=1,reconnect_at_eof=1,reconnect_delay_max=30 \
    --msg-level=all=warn \
    --no-config \
    --no-terminal

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
CPUQuota=50%
MemoryMax=256M

# Security hardening
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milo-radio

[Install]
WantedBy=multi-user.target
