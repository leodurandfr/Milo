[Unit]
Description=Snapcast Server for Milo Multiroom
After=network-online.target
Wants=network-online.target
PartOf=milo-backend.service

[Service]
Type=simple
ExecStart=/usr/bin/snapserver -c /etc/snapserver.conf
User=milo
Group=audio
Restart=on-failure
RestartSec=5
MemoryMax=256M

# Lifecycle: started/stopped exclusively by AudioRoutingService._sync_snapcast_state
# based on settings.routing.multiroom_enabled. Intentionally not WantedBy any target.
